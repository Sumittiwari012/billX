<UserControl x:Class="MyWPFCRUDApp.Views.PrinterSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyWPFCRUDApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FFFDF8F0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Label Printer"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Choose the printer used for all label printing across the app."
                   Foreground="#FF6B6B6B"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="2"
                Background="#FFF8F1E7"
                BorderBrush="#FFD6C4A7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Width="420"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Printer" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="PrinterComboBox"
                          DisplayMemberPath="FullName"
                          Height="32"
                          Margin="0,0,0,12"/>

                <TextBlock x:Name="CurrentDefaultText"
                           FontSize="12"
                           Foreground="#FF6B6B6B"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="🔄 Refresh"
                            Click="RefreshButton_Click"
                            Width="100" Height="32" Margin="0,0,8,0"
                            Background="#FFEEEEEE"/>
                    <Button Content="Save as Default"
                            Click="SaveButton_Click"
                            Width="140" Height="32"
                            Background="#FF1F3A5F"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>