<Window x:Class="MyWPFCRUDApp.Views.ProductLabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Product Label"
        Width="280" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFECECEC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Label Preview (this Border is exactly 46.1mm x 83.8mm — this is what gets printed) -->
        <Border x:Name="PrintArea"
                Width="150" Height="358"
                Background="White"
                BorderBrush="Black" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <!-- NEW: reserved name space, e.g. "ashwin" -->
                    <RowDefinition Height="36"/>
                    <!-- Desc/Qty/Size headers -->
                    <RowDefinition Height="30"/>
                    <!-- Desc/Qty/Size values -->
                    <RowDefinition Height="34"/>
                    <!-- Category (big) -->
                    <RowDefinition Height="80"/>
                    <!-- Barcode -->
                    <RowDefinition Height="50"/>
                    <!-- Company name/address -->
                    <RowDefinition Height="95"/>
                    <!-- MRP -->
                    <RowDefinition Height="*"/>
                    <!-- NO RETURN / remaining -->
                </Grid.RowDefinitions>

                <!-- ── Row 0: Reserved name space (above Desc table) ───────────── -->
                <TextBlock x:Name="TbNameTop"
                           Grid.Row="0"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- ── Row 1+2: Desc / Net Qty / Size table ─────────────────── -->
                <Grid Grid.Row="1" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- borders -->
                    <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="1" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                    <Border Grid.ColumnSpan="3" Grid.Row="0" BorderBrush="Black" BorderThickness="0,1,0,1"/>
                    <Border Grid.ColumnSpan="3" Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,0,1"/>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Desc" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Net Qty" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Size" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock x:Name="TbCategoryShort" Grid.Row="1" Grid.Column="0" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbNetQty" Grid.Row="1" Grid.Column="1" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbSizeVal" Grid.Row="1" Grid.Column="2" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Row 3: Category (big, bold) ──────────────────────────── -->
                <Border Grid.Row="3" BorderBrush="Black" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="TbCategoryBig" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- ── Row 4: Barcode ────────────────────────────────────────── -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="BarcodeImage" Width="150" Height="42" Stretch="Fill"/>
                    <TextBlock x:Name="TbBarcodeNumber" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- ── Row 5: Company name / address ────────────────────────── -->
                <Border Grid.Row="5" BorderBrush="Black" BorderThickness="0,1,0,1" Padding="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TbCompanyName" FontSize="8" FontWeight="Bold"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="TbCompanyAddress" FontSize="7"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Row 6: MRP ────────────────────────────────────────────── -->
                <StackPanel Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MRP   (incl. of all taxes)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="₹" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="TbMRPValue" FontSize="30" FontWeight="Bold" Margin="2,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Row 7: remaining space ────────────────────────────────── -->

            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🖨 Print"
                    Click="PrintButton_Click"
                    Width="110" Height="34" Margin="0,0,8,0"
                    Background="#FF1F3A5F"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Width="80" Height="34"
                    Background="#FFEEEEEE"/>
        </StackPanel>
    </Grid>
</Window>