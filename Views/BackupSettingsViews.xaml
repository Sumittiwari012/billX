<UserControl x:Class="MyWPFCRUDApp.Views.BackupSettingsViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFDF8F0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="Backup Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Automatically back up the database and email a copy every time the application closes."
                       FontSize="12" Foreground="#868E96" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- ══════════════════ Backup file ══════════════════ -->
            <Border Background="White" BorderBrush="#E0D5C4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="LOCAL BACKUP FILE" FontWeight="Bold" FontSize="12" Foreground="#495057" Margin="0,0,0,10"/>

                    <TextBlock Text="Backup folder" FontSize="12" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBackupFolder" Grid.Column="0" Padding="6" Margin="0,0,8,0"/>
                        <Button x:Name="BtnBrowseFolder" Grid.Column="1" Content="Browse…" Padding="10,6" Click="BrowseFolder_Click"/>
                    </Grid>
                    <TextBlock Text="The same file is overwritten on every backup — this is a single always-current copy, not a growing history."
                               FontSize="11" Foreground="#ADB5BD" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════ Email ══════════════════ -->
            <Border Background="White" BorderBrush="#E0D5C4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="BACKUP EMAIL" FontWeight="Bold" FontSize="12" Foreground="#495057" Margin="0,0,0,10"/>

                    <TextBlock Text="Send backup to this email address" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBackupEmail" Padding="6" Margin="0,0,0,10"/>

                    <TextBlock Text="SMTP username (usually your full email address — the account backups are sent FROM)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSmtpUsername" Grid.Column="0" Padding="6" Margin="0,0,8,0"
                                 TextChanged="TxtSmtpUsername_TextChanged"/>
                        <TextBox x:Name="TxtSmtpPort" Grid.Column="1" Padding="6" Text="587" ToolTip="Port"/>
                    </Grid>
                    <!-- Server is derived from the email domain above (see
                         SmtpHostLookup) instead of asking for it directly —
                         this line just shows what was detected so it isn't a
                         total black box. -->
                    <TextBlock x:Name="TxtDetectedHostDisplay" FontSize="11" Foreground="#868E96" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkSmtpUseSsl" Content="Use SSL/TLS" IsChecked="True" Margin="0,0,0,10"/>

                    <TextBlock Text="SMTP password (use an app password, not your normal login password, for Gmail/Outlook)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdSmtpPassword" Padding="6" Margin="0,0,0,10"/>

                    <TextBlock Text="Sender display name" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSenderDisplayName" Padding="6"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════ On/off + actions ══════════════════ -->
            <Border Background="White" BorderBrush="#E0D5C4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="ChkEnableBackupOnClose"
                              Content="Automatically back up and email the database every time this application closes"
                              FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Turn this on only after a Backup Now test below succeeds."
                               FontSize="11" Foreground="#ADB5BD" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSave" Content="Save Settings" Padding="12,7" Margin="0,0,8,0"
                        Background="#FF1F3A5F" Foreground="White" FontWeight="Bold" Click="SaveButton_Click"/>
                <Button x:Name="BtnBackupNow" Content="Backup Now" Padding="12,7" Margin="0,0,8,0" Click="BackupNowButton_Click"/>
                <Button x:Name="BtnTestEmail" Content="Send Test Email" Padding="12,7" Click="TestEmailButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
