<Window x:Class="MyWPFCRUDApp.Views.BillScanReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Scanned Bill — Confirm before importing"
        Width="1050" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="Auto"/>  <!-- 1: Bill header fields -->
            <RowDefinition Height="*"/>     <!-- 2: DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- 3: Percentage inputs -->
            <RowDefinition Height="Auto"/>  <!-- 4: Buttons -->
        </Grid.RowDefinitions>

        <!-- ── ROW 0: Header ── -->
        <Border Grid.Row="0" Background="#1971C2" CornerRadius="8"
                Padding="16,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🤖  AI Scanned Bill — Review &amp; Edit"
                           Foreground="White" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  ·  All fields are editable. Correct any mistakes, then click Approve."
                           Foreground="#A5D8FF" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── ROW 1: Bill Header Fields ── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Invoice Number" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox Text="{Binding ScannedBill.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Bill Date" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox Text="{Binding ScannedBill.InvoiceDate, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Supplier (from bill)" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox Text="{Binding ScannedBill.SupplierName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Grand Total (₹)" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding ScannedBill.GrandTotal, StringFormat=₹{0:N2}}"
                               FontSize="20" FontWeight="ExtraBold" Foreground="#1971C2"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ROW 2: Line Items DataGrid ── -->
        <DataGrid Grid.Row="2"
                  x:Name="ItemsGrid"
                  ItemsSource="{Binding ScannedBill.Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  CellEditEnding="ItemsGrid_CellEditEnding"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E9ECEF"
                  Background="White"
                  BorderBrush="#DEE2E6"
                  BorderThickness="1">

            <DataGrid.Columns>

                <DataGridTextColumn Header="#"
                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                    Width="36" IsReadOnly="True"/>

                <DataGridTextColumn Header="Description"
                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    Width="*"/>

                <DataGridTextColumn Header="Qty"
                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                    Width="65"/>

                <!-- Purchase Price -->
                <DataGridTextColumn Header="Purchase Price (₹)"
                    Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Wholesale Price — auto-filled by % input -->
                <DataGridTextColumn Header="Wholesale (₹)"
                    Binding="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="115">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#2B8A3E"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- MRP — auto-filled by % input -->
                <DataGridTextColumn Header="MRP (₹)"
                    Binding="{Binding MRP, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#1971C2"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Amount (₹)"
                    Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Delete row -->
                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✖" Tag="{Binding}"
                                    Click="DeleteRowButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#E03131" Cursor="Hand" FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── ROW 3: Percentage Inputs ── -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Auto-calculate prices from Purchase Price:"
                           FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Wholesale % -->
                <Border Background="#EBF8EE" CornerRadius="4" Padding="10,6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Wholesale = Purchase +"
                                   VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Width="60" Height="28"
                                 Text="{Binding WholesalePercentage, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Center"
                                 FontWeight="Bold"
                                 BorderBrush="#2B8A3E"/>
                        <TextBlock Text="%" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#2B8A3E" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- MRP % -->
                <Border Background="#E7F5FF" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MRP = Purchase +"
                                   VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Width="60" Height="28"
                                 Text="{Binding MRPPercentage, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Center"
                                 FontWeight="Bold"
                                 BorderBrush="#1971C2"/>
                        <TextBlock Text="%" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1971C2" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="  ← Change % to update all rows instantly"
                           FontSize="11" Foreground="#868E96"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── ROW 4: Buttons ── -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Items extracted: " FontSize="12" Foreground="#6C757D"/>
                <TextBlock Text="{Binding ScannedBill.Items.Count}"
                           FontSize="12" FontWeight="Bold" Margin="2,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="CancelButton_Click"
                        Width="90" Height="36" Margin="0,0,10,0"
                        Background="White" BorderBrush="#DEE2E6"/>
                <Button Content="✔  Approve &amp; Transfer to Purchase"
                        Click="ApproveButton_Click"
                        Width="260" Height="36"
                        Background="#1971C2" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
