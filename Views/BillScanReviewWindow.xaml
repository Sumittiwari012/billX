<Window x:Class="MyWPFCRUDApp.Views.BillScanReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Scanned Bill — Confirm before importing"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Background="#1971C2"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🤖  AI Scanned Bill — Review &amp; Edit"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  ·  All fields are editable. Correct any mistakes, then click Approve."
                           Foreground="#A5D8FF"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Bill Header Fields ── -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Invoice Number" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox x:Name="TbInvoice"
                             Text="{Binding ScannedBill.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Bill Date" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox x:Name="TbDate"
                             Text="{Binding ScannedBill.InvoiceDate, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Supplier (from bill)" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBox x:Name="TbSupplier"
                             Text="{Binding ScannedBill.SupplierName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Grand Total (₹)" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding ScannedBill.GrandTotal, StringFormat=₹{0:N2}}"
                               FontSize="20" FontWeight="ExtraBold"
                               Foreground="#1971C2"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Line Items DataGrid ── -->
        <DataGrid Grid.Row="2"
                  x:Name="ItemsGrid"
                  ItemsSource="{Binding ScannedBill.Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E9ECEF"
                  Background="White"
                  BorderBrush="#DEE2E6"
                  BorderThickness="1">

            <DataGrid.Columns>

                <!-- Row number (read only) -->
                <DataGridTextColumn Header="#"
                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                    Width="36" IsReadOnly="True"/>

                <!-- Description — editable -->
                <DataGridTextColumn Header="Description"
                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    Width="180"/>

                <!-- Quantity — editable -->
                <DataGridTextColumn Header="Qty"
                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                    Width="70"/>

                <!-- Rate — editable -->
                <DataGridTextColumn Header="Rate (₹)"
                    Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="100"/>

                <!-- Amount — auto-calculated, editable for override -->
                <DataGridTextColumn Header="Amount (₹)"
                    Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                    Width="110"/>

                <!-- Product Match — ComboBox dropdown to link to existing product -->
                <DataGridTemplateColumn Header="Match to Product" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MatchedProductName}"
                                       Padding="6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding MatchedProductId,
                                           Converter={StaticResource ProductMatchColorConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Products,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="ProductName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding MatchedProductId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="ProductComboBox_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Delete row button -->
                <DataGridTemplateColumn Header="" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✖"
                                    Tag="{Binding}"
                                    Click="DeleteRowButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#E03131"
                                    Cursor="Hand"
                                    FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Warning bar if unmatched items ── -->
        <Border Grid.Row="3"
                Background="#FFF3CD"
                BorderBrush="#FFC107"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,8,0,0"
                Visibility="{Binding UnmatchedWarningVisibility}">
            <TextBlock Text="{Binding UnmatchedWarningText}"
                       Foreground="#856404"
                       FontSize="12"/>
        </Border>

        <!-- ── Bottom Buttons ── -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Items extracted: " FontSize="12" Foreground="#6C757D"/>
                <TextBlock Text="{Binding ScannedBill.Items.Count}"
                           FontSize="12" FontWeight="Bold" Margin="2,0,16,0"/>
                <TextBlock Text="Matched: " FontSize="12" Foreground="#6C757D"/>
                <TextBlock Text="{Binding MatchedCount}"
                           FontSize="12" FontWeight="Bold" Foreground="#2B8A3E" Margin="2,0,16,0"/>
                <TextBlock Text="Unmatched: " FontSize="12" Foreground="#6C757D"/>
                <TextBlock Text="{Binding UnmatchedCount}"
                           FontSize="12" FontWeight="Bold" Foreground="#E03131"/>
                <TextBlock Text="  (unmatched items will be offered as new products)"
                           FontSize="11" Foreground="#868E96" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Width="90" Height="36" Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#DEE2E6"/>
                <Button Content="✔  Approve &amp; Transfer to Purchase"
                        Click="ApproveButton_Click"
                        Width="260" Height="36"
                        Background="#1971C2"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
