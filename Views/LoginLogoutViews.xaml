<UserControl x:Class="MyWPFCRUDApp.Views.LoginLogoutViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyWPFCRUDApp.Views"
             Background="AliceBlue"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Login / Logout Records" Margin="5">
            <DataGrid ItemsSource="{Binding LoginLogouts}" 
                      SelectedItem="{Binding SelectedLoginLogout}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single" Margin="0,0,-434,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Counter" Binding="{Binding CounterName}" Width="*"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Login" Binding="{Binding LoginTime}" Width="*"/>
                    <DataGridTextColumn Header="Logout" Binding="{Binding LogoutTime}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Settled" Binding="{Binding Settlement}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>