<Window x:Class="MyWPFCRUDApp.Views.ProductVarianceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Variance"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F3F5">

    <StackPanel Margin="16">
        <TextBlock x:Name="TxtProductLabel" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"
                   TextWrapping="Wrap"/>
        <TextBlock Text="Choose which field this variance is based on, then fill in a value and quantity for each row. Row 1 is the item you selected."
                   Foreground="#495057" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Vary by:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox x:Name="ComboField" Width="200" Height="30"
                      SelectionChanged="ComboField_SelectionChanged"/>
        </StackPanel>

        <Border Background="White" CornerRadius="6" BorderBrush="#DEE2E6" BorderThickness="1"
                Padding="10" MaxHeight="360">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=""/>
                        <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" FontSize="11" Foreground="#495057"/>
                        <TextBlock Grid.Column="2" Text="Quantity" FontWeight="SemiBold" FontSize="11" Foreground="#495057"/>
                    </Grid>
                    <ItemsControl x:Name="SlotsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FieldValue, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Margin="0,0,8,0"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             PreviewKeyDown="Input_PreviewKeyDown"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" VerticalContentAlignment="Center"
                                             Padding="6,0" TextAlignment="Center"
                                             PreviewKeyDown="Input_PreviewKeyDown"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="34" Margin="0,0,10,0"
                    Background="White" BorderBrush="#CED4DA"/>
            <Button Content="Add Variance" Click="Ok_Click" Width="140" Height="34"
                    Background="#0CA678" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
