<Window x:Class="MyWPFCRUDApp.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment" Width="680" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header info bar -->
            <RowDefinition Height="Auto"/>
            <!-- Payment inputs -->
            <RowDefinition Height="Auto"/>
            <!-- Remaining amount -->
            <RowDefinition Height="*"/>
            <!-- Payment history table -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── ROW 0: Header — Supplier + Invoice info ── -->
        <Border Grid.Row="0" Background="#1971C2" CornerRadius="8"
                Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Record Payment" Foreground="White"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Enter payment details below"
                               Foreground="#A5D8FF" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Supplier + Invoice info -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Supplier: " Foreground="#A5D8FF"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SupplierName, Mode=OneWay}"
           Foreground="White" FontWeight="Bold"
           FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" · ID: " Foreground="#A5D8FF"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SupplierId,Mode=OneWay}"
                                   Foreground="White" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0">
    <Run Text="Invoice: " Foreground="#A5D8FF" FontSize="12"/>
    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" Foreground="White"
         FontWeight="Bold" FontSize="12"/>
    <Run Text="  Total: " Foreground="#A5D8FF" FontSize="12"/>
    <Run Text="{Binding InvoiceTotal, Mode=OneWay, StringFormat=₹{0:N2}}"
         Foreground="#74C0FC" FontWeight="Bold" FontSize="13"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ROW 1: Payment inputs ── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6"
                BorderThickness="1" CornerRadius="8" Padding="16,14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Payment Method -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Payment Method" FontSize="11"
                               FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}"
                              DisplayMemberPath="PaymentMethod"
                              Height="32"/>
                </StackPanel>

                <!-- Bank Account — visible only when Online is selected -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0"
                            Visibility="{Binding BankAccountVisibility}">
                    <TextBlock Text="Bank Account" FontSize="11"
                               FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding BankAccounts}"
                              SelectedItem="{Binding SelectedBankAccount}"
                              DisplayMemberPath="AccountNumber"
                              Height="32"/>
                </StackPanel>

                <!-- Amount -->
                <!-- Amount -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Amount Paid (₹) *" FontSize="11"
               FontWeight="Bold" Foreground="#E03131" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountBox"
             Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}"
             Height="32" TextAlignment="Right"
             VerticalContentAlignment="Center"
             FontSize="14" FontWeight="Bold"
             BorderThickness="2">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#1971C2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmountPaid}" Value="0">
                                        <Setter Property="BorderBrush" Value="#E03131"/>
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="Enter amount to record"
               FontSize="10" Foreground="#E03131"
               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmountPaid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ROW 2: Remaining amount ── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6"
                BorderThickness="1" CornerRadius="8" Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Invoice Total" FontSize="11"
               Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InvoiceTotal, Mode=OneWay, StringFormat=₹{0:N2}}"
               FontSize="16" FontWeight="Bold" Foreground="#212529"/>
                </StackPanel>

                <!-- Amount Paying — must bind to AmountPaid not Balance -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Amount Paying" FontSize="11"
               Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AmountPaid, StringFormat=₹{0:N2}}"
               FontSize="16" FontWeight="Bold" Foreground="#2B8A3E"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Remaining" FontSize="11"
                               Foreground="#6C757D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Balance, StringFormat=₹{0:N2}}"
                               FontSize="16" FontWeight="ExtraBold"
                               Foreground="{Binding BalanceBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ROW 3: Payment history table ── -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DEE2E6"
                BorderThickness="1" CornerRadius="8" Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PAYMENT HISTORY"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#6C757D" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PaymentHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E9ECEF"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"
                            Binding="{Binding PaymentDate, StringFormat={}{0:dd MMM yyyy}}"
                            Width="130"/>
                        <DataGridTextColumn Header="Payment Method"
                            Binding="{Binding PaymentMethod}"
                            Width="*"/>
                        <DataGridTextColumn Header="Bank Account"
                            Binding="{Binding BankAccount}"
                            Width="140"/>
                        <DataGridTextColumn Header="Amount (₹)"
                            Binding="{Binding Amount, StringFormat={}{0:N2}}"
                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#2B8A3E"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <TextBlock Grid.Row="1"
                           Text="No payments recorded yet."
                           Foreground="#868E96" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding EmptyHistoryVisibility}"/>
            </Grid>
        </Border>

        <!-- ── ROW 4: Buttons ── -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click"
                    Width="90" Height="36" Margin="0,0,10,0"
                    Background="White" BorderBrush="#DEE2E6"/>
            <Button Content="✔  Record Payment"
        Command="{Binding RecordPaymentCommand}"
        Width="180" Height="36"
        Background="#E1AD01" Foreground="White"
        FontWeight="Bold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>