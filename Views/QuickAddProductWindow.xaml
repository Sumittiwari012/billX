<Window x:Class="MyWPFCRUDApp.Views.QuickAddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Add Product"
        Width="380" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFDF8F0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Product name" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtProductName" Grid.Row="1" Height="32" Padding="6"
                 VerticalContentAlignment="Center" KeyDown="TxtProductName_KeyDown"/>

        <TextBlock Grid.Row="2"
                   Text="A barcode is generated automatically. Fill in price, quantity, and other details directly in the item grid afterward."
                   FontSize="11" Foreground="#868E96" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Add" Width="80" Height="30" Background="#1971C2" Foreground="White"
                    FontWeight="Bold" Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
