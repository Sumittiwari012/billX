<UserControl x:Class="MyWPFCRUDApp.Views.GodownViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" Margin="0,0,0,12" CornerRadius="6"
                BorderBrush="#DDD" BorderThickness="1" Background="White">
            <StackPanel>
                <TextBlock Text="Godown Master" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Godown Name *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding GodownName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="100" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Address" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="300" Padding="6"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Width="90" Padding="6" Margin="0,0,8,0"/>
                    <Button Content="New" Command="{Binding NewCommand}"
                            Width="90" Padding="6" Margin="0,0,8,0"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}"
                            Width="90" Padding="6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Godowns}"
                  SelectedItem="{Binding SelectedGodown, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Godown Name" Binding="{Binding GodownName}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
