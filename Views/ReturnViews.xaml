<UserControl x:Class="MyWPFCRUDApp.Views.ReturnViews" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:MyWPFCRUDApp.ViewModels" FontFamily="Segoe UI" FontSize="13" Background="#F4F6F9">
    <UserControl.DataContext>
        <vm:ReturnViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <!-- ═══════════════════════════════════════════════════════════════ Palette ═══════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Navy" Color="#1F3A5F"/>
        <SolidColorBrush x:Key="NavySoft" Color="#E8ECF2"/>
        <SolidColorBrush x:Key="Ink" Color="#1B2430"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7685"/>
        <SolidColorBrush x:Key="Line" Color="#DDE2EA"/>
        <SolidColorBrush x:Key="Danger" Color="#B83A2E"/>
        <SolidColorBrush x:Key="Card" Color="White"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ═══════════════════════════════════════════════════════════════ Base Button ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Navy}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6F8FBF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary button -->
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource NavySoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        </Style>
        <!-- Danger button -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <!-- Small danger button -->
        <Style x:Key="BtnDangerGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <!-- ═══════════════════════════════════════════════════════════════ Fields ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldDate" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Label -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Card -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <!-- Numeric cells -->
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- Text cells -->
        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </UserControl.Resources>
    <!-- ═══════════════════════════════════════════════════════════════════ Main ═══════════════════════════════════════════════════════════════════ -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ═══════════════════════════════════════════════════════════════ Title ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Purchase return" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource NavySoft}" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource Navy}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="History" Style="{StaticResource BtnSecondary}" Command="{Binding ToggleHistoryCommand}" Margin="0,0,8,0"/>
                <Button Content="Reset" Style="{StaticResource BtnSecondary}" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </Grid>
        <!-- ═══════════════════════════════════════════════════════════════ Main Content ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <!-- ═══════════════════════════════════════════════════════════ LEFT SIDE ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ═══════════════════════════════════════════════════════ Header Details ═══════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Supplier -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Supplier" Style="{StaticResource Label}"/>
                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName"/>
                            <TextBlock Text="Select a supplier to start a return." Foreground="{StaticResource Danger}" FontSize="11.5" Margin="0,4,0,0" Visibility="{Binding SupplierHintVisibility}"/>
                        </StackPanel>
                        <!-- Return number -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Text="Return no." Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource Field}" IsReadOnly="True" Background="#F4F6F9" Text="{Binding ReturnInvoiceNumber, Mode=OneWay}"/>
                        </StackPanel>
                        <!-- Return date -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Return date" Style="{StaticResource Label}"/>
                            <DatePicker Style="{StaticResource FieldDate}" SelectedDate="{Binding ReturnDate}"/>
                        </StackPanel>
                        <!-- ═══════════════════════════════════════════════ Original Purchase Invoice ═══════════════════════════════════════════════ -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Original purchase invoice" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource FieldCombo}" ItemsSource="{Binding SupplierInvoices}" SelectedItem="{Binding SelectedSupplierInvoice}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding InvoiceNumber}" FontWeight="SemiBold" Width="90"/>
                                                <TextBlock Text="{Binding PurchaseDate, StringFormat=dd-MMM-yyyy}" Foreground="{StaticResource Muted}" Width="110"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="Load items" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Padding="14,6" Command="{Binding LoadFromInvoiceCommand}"/>
                                <Button Grid.Column="2" Content="Unlink" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Padding="14,6" Command="{Binding ClearInvoiceLinkCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding LinkedInvoiceDisplay}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- ═══════════════════════════════════════════════════════ ITEMS GRID ═══════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding ReturnItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAFBFD" RowHeight="34" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Navy}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Product -->
                                <DataGridTextColumn Header="Product" Width="2*" IsReadOnly="True" Binding="{Binding ProductName}" ElementStyle="{StaticResource TextCell}"/>
                                <!-- Barcode -->
                                <DataGridTextColumn Header="Barcode" Width="110" IsReadOnly="True" Binding="{Binding Barcode}" ElementStyle="{StaticResource TextCell}"/>
                                <!-- Batch -->
                                <DataGridTextColumn Header="Batch" Width="90" Binding="{Binding Batch, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource TextCell}"/>
                                <!-- Mfg -->
                                <DataGridTemplateColumn Header="Mfg date" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MfgDate, StringFormat=dd-MM-yyyy}" Style="{StaticResource TextCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding MfgDate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- Exp -->
                                <DataGridTemplateColumn Header="Exp date" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ExpDate, StringFormat=dd-MM-yyyy}" Style="{StaticResource TextCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding ExpDate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- Quantity -->
                                <DataGridTextColumn Header="Qty" Width="70" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource NumCell}"/>
                                <!-- Price -->
                                <DataGridTextColumn Header="Price" Width="90" Binding="{Binding PurchasePrice, StringFormat=N2, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource NumCell}"/>
                                <!-- Amount -->
                                <DataGridTextColumn Header="Amount" Width="100" IsReadOnly="True" Binding="{Binding Amount, StringFormat=N2}" ElementStyle="{StaticResource NumCell}"/>
                                <!-- Reason -->
                                <DataGridTextColumn Header="Reason" Width="*" Binding="{Binding Reason, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource TextCell}"/>
                                <!-- Remove -->
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Remove this item" Style="{StaticResource BtnDangerGhost}" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Empty state -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextAlignment="Center" Text="No items yet. Select an original purchase invoice and load its items.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style></TextBlock>
                    </Grid>
                </Border>
            </Grid>
            <!-- ═══════════════════════════════════════════════════════════ RIGHT SIDE — SUMMARY ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Summary" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/>
                    <!-- Items -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Items" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ItemCount}" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- Quantity -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Total quantity" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding TotalQuantity, StringFormat=N2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- Total -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,6,0,10" Padding="0,10,0,0">
                        <Grid>
                            <TextBlock Text="Return total" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Navy}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <!-- Supplier balance -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Supplier balance now" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding SupplierBalance, StringFormat=₹{0:N2}}" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- Projected balance -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="After this return" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ProjectedBalance, StringFormat=₹{0:N2}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- Remarks -->
                    <TextBlock Text="Remarks" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource Field}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                    <!-- Save -->
                    <Button Content="Save return" Height="38" Margin="0,0,0,8" Command="{Binding SaveReturnCommand}"/>
                    <!-- Delete -->
                    <Button Content="Delete this return" Style="{StaticResource BtnDanger}" Height="34" Command="{Binding DeleteReturnCommand}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <!-- ═══════════════════════════════════════════════════════════ HISTORY OVERLAY ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="480" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Panel.ZIndex="10" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- History header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Return history" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                        <Button Content="Close" Style="{StaticResource BtnSecondary}" Padding="12,4" HorizontalAlignment="Right" Command="{Binding ToggleHistoryCommand}"/>
                    </Grid>
                    <!-- History list -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SupplierHistory}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- History information -->
                                        <StackPanel>
                                            <!-- Return number + date -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ReturnInvoiceNumber}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ReturnDate, StringFormat=dd-MMM-yyyy}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <!-- Supplier -->
                                            <TextBlock Text="{Binding SupplierName}" Foreground="{StaticResource Ink}" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            <!-- Amount -->
                                            <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}" Foreground="{StaticResource Navy}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <!-- Original invoice -->
                                            <TextBlock Text="{Binding InvoiceNumber, StringFormat=Against invoice: {0}}" Foreground="{StaticResource Muted}" FontSize="11.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InvoiceNumber}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding InvoiceNumber}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </StackPanel>
                                        <!-- History buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Open" Style="{StaticResource BtnSecondary}" Padding="12,4" Command="{Binding DataContext.LoadHistoryReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource BtnDangerGhost}" Margin="4,0,0,0" Command="{Binding DataContext.DeleteReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>