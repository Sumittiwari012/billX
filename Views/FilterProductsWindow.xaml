<Window x:Class="MyWPFCRUDApp.Views.FilterProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Products" Height="220" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFDF8F0">
    <StackPanel Margin="16">
        <TextBlock Text="Filter by column" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="FieldCombo"
                  Margin="0,0,0,12"
                  SelectionChanged="FieldCombo_SelectionChanged"/>

        <TextBlock Text="Value" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="ValueCombo"
                  IsEditable="False"
                  Margin="0,0,0,16"/>

        <TextBlock x:Name="NoValuesText"
                   Text="No values available for this column."
                   Foreground="DarkRed"
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Apply Filter" Width="110" Height="32"
                    Background="#FF1F3A5F" Foreground="White" FontWeight="Bold"
                    Click="Apply_Click"/>
        </StackPanel>
    </StackPanel>
</Window>