<Window x:Class="MyWPFCRUDApp.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Product" Height="340" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F3F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <!-- Header hint -->
            <TextBlock Text="Only the barcode is required. All other fields are optional and can be filled in later."
                       TextWrapping="Wrap"
                       Foreground="#868E96"
                       FontSize="11"
                       Margin="0,0,0,14"/>

            <!-- Barcode row -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Barcode *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBarcode"
                             Height="32"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             ToolTip="Auto-generated. You may edit it before saving."/>
                </StackPanel>

                <!-- Regenerate button -->
                <Button Grid.Column="1"
                        Content="↺ Regenerate"
                        Click="BtnRegenerate_Click"
                        Margin="8,20,0,0"
                        Height="32"
                        Padding="10,0"
                        Background="#E7F5FF"
                        Foreground="#1971C2"
                        BorderBrush="#74C0FC"
                        FontSize="12"
                        ToolTip="Reset to the next system-generated barcode"/>
            </Grid>

            <!-- Product Name -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Product Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="6,0"
                         ToolTip="Optional – can be updated later"/>
            </StackPanel>

            <!-- Category + Unit on same row -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboCategory"
                              DisplayMemberPath="CategoryName"
                              SelectedValuePath="Id"
                              Height="30"
                              SelectionChanged="ComboCategory_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Unit" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboUnit"
                              DisplayMemberPath="UnitName"
                              SelectedValuePath="Id"
                              Height="30"/>
                </StackPanel>
            </Grid>

        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Cancel"
                    IsCancel="True"
                    Width="80" Height="34"
                    Margin="0,0,10,0"
                    Background="White"
                    BorderBrush="#CED4DA"/>

            <Button Content="Save Product"
                    Click="Save_Click"
                    Width="130" Height="34"
                    Background="#2F9E44"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
