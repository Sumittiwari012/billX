<UserControl x:Class="MyWPFCRUDApp.Views.PurchaseViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 · Supplier + Invoice + Date ══ -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                Padding="15" Margin="0,0,0,10"
                BorderBrush="#DEE2E6" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Supplier -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="Supplier *" FontSize="11" FontWeight="Bold"/>
                    <DockPanel>
                        <Button Content="+ New"
                                Command="{Binding OpenAddSupplierCommand}"
                                DockPanel.Dock="Right"
                                Padding="10,0" Margin="5,0,0,0"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="SupplierName"
                                  Height="32" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <!-- Invoice Number -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="Invoice Number *" FontSize="11" FontWeight="Bold"/>
                    <TextBox Text="{Binding PurchaseMaster.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Date -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <Label Content="Purchase Date" FontSize="11" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding PurchaseMaster.PurchaseDate}"
                                Height="32" Width="130"/>
                </StackPanel>

                <!-- Barcode Search -->
                <Border Grid.Column="3" Background="#E7F5FF" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                    <StackPanel>
                        <Label Content="SCAN BARCODE / SEARCH" Foreground="#1971C2" FontWeight="ExtraBold" FontSize="10"/>
                        <TextBox x:Name="SearchBox" Height="32"
                                 BorderBrush="#A5D8FF" BorderThickness="2"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding BarcodeSearchCommand}"
                                            CommandParameter="{Binding ElementName=SearchBox, Path=Text}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- ★ Scan Bill Button ★ -->
                <Border Grid.Column="4" Background="#EBF8EE" CornerRadius="8" Padding="10,8">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="AI BILL SCAN" Foreground="#2B8A3E"
                                       FontWeight="ExtraBold" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Button Content="⚙"
                                    Command="{Binding OpenApiKeySetupCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2B8A3E"
                                    FontSize="13"
                                    Cursor="Hand"
                                    ToolTip="Configure AI API Key"
                                    Margin="6,0,0,0"
                                    Padding="0"/>
                        </StackPanel>
                        <Button Content="📄  Scan Bill"
                                Command="{Binding ScanBillCommand}"
                                Height="34" Padding="14,0" Margin="0,4,0,0"
                                Background="#2B8A3E" Foreground="White"
                                FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock Text="{Binding ScanHintText}"
                                   Foreground="#E03131" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding ScanHintVisibility}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ ROW 2 · Invoice Items — EDITABLE DataGrid ══ -->
        <GroupBox Header="Invoice Items" Grid.Row="2" Background="White">
            <DataGrid x:Name="PurchaseGrid"
                      ItemsSource="{Binding PurchaseItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      AlternatingRowBackground="#F8F9FA"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E9ECEF"
                      CellEditEnding="PurchaseGrid_CellEditEnding">

                <DataGrid.Columns>

                    <!-- # -->
                    <DataGridTextColumn Header="#"
                        Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                        Width="40" IsReadOnly="True"/>

                    <!-- Barcode (pre-assigned, read-only) -->
                    <DataGridTextColumn Header="Barcode"
                        Binding="{Binding Barcode}"
                        Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="#1971C2"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Product Name (editable — type name for new scanned items) -->
                    <DataGridTextColumn Header="Product Name"
                        Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Purchase Price — EDITABLE -->
                    <DataGridTextColumn Header="Price (₹)"
                        Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Wholesale Price — EDITABLE -->
                    <DataGridTextColumn Header="Wholesale (₹)"
                        Binding="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                        Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#2B8A3E"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- MRP — EDITABLE -->
                    <DataGridTextColumn Header="MRP (₹)"
                        Binding="{Binding MRP, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#1971C2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Quantity — EDITABLE -->
                    <DataGridTextColumn Header="Qty"
                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Net Amount — auto-calculated -->
                    <DataGridTextColumn Header="Net Amount (₹)"
                        Binding="{Binding AfterTaxation, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1971C2"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Remove -->
                    <DataGridTemplateColumn Header="" Width="75" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.PurchaseDeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#E03131" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ══ ROW 3 · Footer ══ -->
        <Border Grid.Row="3" Background="#F1F3F5" CornerRadius="0,0,8,8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <Label Content="Remarks" FontSize="11" FontWeight="Bold"/>
                        <TextBox Text="{Binding PurchaseMaster.Remarks}" Width="250" Height="28"/>
                    </StackPanel>
                    <Button Content="Clear Form"
                            Command="{Binding PurchaseResetCommand}"
                            Width="100" Height="30" VerticalAlignment="Bottom"
                            Background="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,30,0" VerticalAlignment="Center">
                        <Label Content="Discount" HorizontalAlignment="Right" FontSize="11"/>
                        <TextBox Text="{Binding PurchaseMaster.Discount,
                                     UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Width="100" Height="28" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <Label Content="GRAND TOTAL" HorizontalAlignment="Right"
                               FontSize="11" FontWeight="Bold" Foreground="#495057"/>
                        <TextBlock Text="{Binding PurchaseMaster.TotalAmount, StringFormat={}{0:C}}"
                                   FontSize="28" FontWeight="ExtraBold"
                                   Foreground="#1971C2" TextAlignment="Right"/>
                    </StackPanel>
                    <Button Content="SAVE INVOICE"
                            Command="{Binding PurchaseSaveCommand}"
                            Width="180" Height="50"
                            Background="#1971C2" Foreground="White"
                            FontSize="16" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
