<UserControl x:Class="MyWPFCRUDApp.Views.PurchaseViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F8F9FA">

    <UserControl.Resources>
        <!-- ══════════════════════════════════════════════════════════════════
             Fix for colored grid-cell text disappearing on selection:
             WPF's DataGrid normally swaps cell text to white automatically
             when a row/cell is selected, for contrast against the blue
             selection background. But a hard-coded Foreground Setter (like
             the blue used for MRP/Retail/Barcode/Net Amount below) sits at a
             higher precedence than that automatic swap, so the colored text
             just stays blue-on-blue and becomes unreadable the moment you
             click the cell.

             BaseCellText below adds a trigger that forces white text back on
             specifically when the cell is selected — regardless of whatever
             color a derived style sets — so every colored column stays
             legible on click. Non-colored columns (Product Name, Qty, Price)
             don't need this since they never override Foreground in the
             first place.
             ══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="BaseCellText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarcodeCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseCellText}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#1971C2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WholesaleCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseCellText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#2B8A3E"/>
        </Style>

        <Style x:Key="MrpRetailCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseCellText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#1971C2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NetAmountCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseCellText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1971C2"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8"
                Padding="15" Margin="0,0,0,10"
                BorderBrush="#DEE2E6" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <Label Content="Supplier *" FontSize="11" FontWeight="Bold"/>
                    <DockPanel>
                        <!-- History dropdown toggle -->
                        <Button Content="History"
                                Click="HistoryButton_Click"
                                DockPanel.Dock="Right"
                                Padding="10,0" Margin="5,0,0,0"
                                Height="32"/>
                        <!-- Fixed Width so the combo no longer stretches to
                             fill whatever space DockPanel has left — that's
                             what was making the Supplier column wider than
                             it needed to be.

                             The standalone "+ New" button that used to sit
                             here is gone — it's now the first row INSIDE the
                             dropdown itself (see the custom Template below),
                             which needs a retemplated ComboBox since a plain
                             ItemsSource binding can't mix in an extra row
                             that isn't part of the Suppliers collection. -->
                        <ComboBox x:Name="SupplierCombo"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="SupplierName"
                                  Width="140" Height="32" VerticalContentAlignment="Center">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton"
                                                      Background="White"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="White"
                                                            BorderBrush="#CED4DA"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#495057"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter x:Name="ContentSite"
                                                          IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="8,0,20,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"/>

                                        <Popup x:Name="Popup"
                                               Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Slide">
                                            <Border Background="White"
                                                    BorderBrush="#CED4DA"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                    MaxHeight="260">
                                                <!-- DockPanel, not StackPanel: a StackPanel always gives its
                                                     children infinite available height (that's how it measures
                                                     natural size), so the ScrollViewer below would never get a
                                                     bounded height to scroll within — it'd just expand to fit
                                                     every supplier and anything past the Border's MaxHeight
                                                     would be invisible with no way to reach it. DockPanel gives
                                                     its Fill child (the ScrollViewer, last/undocked) whatever
                                                     height is actually left after the docked rows above it. -->
                                                <DockPanel>
                                                    <!-- "+ New" pinned as the very first row of the dropdown -->
                                                    <Button Content="+ New Supplier"
                                                            Command="{Binding OpenAddSupplierCommand}"
                                                            Click="AddSupplierMenuItem_Click"
                                                            DockPanel.Dock="Top"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="10,6"
                                                            Background="#E7F5FF"
                                                            BorderThickness="0"
                                                            FontWeight="Bold"
                                                            Foreground="#1971C2"
                                                            Cursor="Hand"/>
                                                    <Separator DockPanel.Dock="Top" Margin="0"/>
                                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0" Orientation="Horizontal">

                    <!-- Editable Invoice Number (MS-format) -->
                    <StackPanel Margin="0,0,15,0">
                        <Label Content="Invoice Number *" FontSize="11" FontWeight="Bold"/>
                        <TextBox Text="{Binding PurchaseMaster.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                 Width="130" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Readonly Vendor Invoice Number (M-format) -->
                    <StackPanel Margin="0,0,15,0">
                        <Label Content="Vendor Invoice No." FontSize="11" FontWeight="Bold" Foreground="#495057"/>
                        <Border Background="#F1F3F5" BorderBrush="#DEE2E6" BorderThickness="1"
                CornerRadius="4" Height="32" Padding="10,0" MinWidth="110">
                            <TextBlock Text="{Binding VendorInvoiceNumber, TargetNullValue='—'}"
                       Foreground="#1971C2" FontWeight="Bold" FontFamily="Consolas"
                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Supplier Wallet (unchanged) -->
                    <StackPanel>
                        <Label Content="Supplier Wallet" FontSize="11" FontWeight="Bold" Foreground="#495057"/>
                        <Border Background="#F1F3F5" BorderBrush="#DEE2E6" BorderThickness="1"
                CornerRadius="4" Height="32" Padding="10,0" MinWidth="110">
                            <TextBlock Text="{Binding SupplierBalance, StringFormat={}{0:C}, TargetNullValue='₹0.00'}"
                       Foreground="#E03131" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Border>
                    </StackPanel>

                </StackPanel>

                <!-- Purchase Date: width reduced from 130 to 100 -->
                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <Label Content="Purchase Date" FontSize="11" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding PurchaseMaster.PurchaseDate}"
                                Height="32" Width="100"/>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════
                     Import Excel: relocated here from the Invoice Summary
                     panel on the right, so it now sits in the toolbar right
                     after Purchase Date instead of being buried among the
                     summary action buttons. Wrapped with the same blank
                     spacer Label used for Print so its Button lines up with
                     the rest of the row's controls.
                     ══════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="3" Margin="0,0,15,0" VerticalAlignment="Top">
                    <Label Content=" " FontSize="11" FontWeight="Bold"/>
                    <Button Content="📥 Import Excel"
                            Command="{Binding ImportExcelCommand}"
                            Height="34" Padding="10,0"
                            Background="#0CA678"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Scan Barcode / Search: TextBox width reduced from 180 to 120,
                     tightening the overall footprint of this section -->
                <Border Grid.Column="4" Background="#E7F5FF" Padding="10" CornerRadius="5" Margin="0,0,15,0">
                    <StackPanel>
                        <Label Content="SCAN BARCODE / SEARCH" Foreground="#1971C2" FontWeight="ExtraBold" FontSize="10"/>
                        <DockPanel>
                            <Button Content="+ Add"
                                    Click="QuickAddButton_Click"
                                    DockPanel.Dock="Right"
                                    Height="32" Padding="10,0" Margin="6,0,0,0"
                                    Background="#1971C2" Foreground="White" FontWeight="Bold"
                                    Cursor="Hand"
                                    ToolTip="Add a new product directly to the item list with an auto-generated barcode.">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBox x:Name="SearchBox" Width="120" Height="32"
                                     BorderBrush="#A5D8FF" BorderThickness="2"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding BarcodeSearchCommand}"
                                                CommandParameter="{Binding ElementName=SearchBox, Path=Text}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Background="#EBF8EE" CornerRadius="8" Padding="10,8" Margin="0,0,15,0">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="AI BILL SCAN" Foreground="#2B8A3E"
                                       FontWeight="ExtraBold" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Button Content="⚙"
                                    Command="{Binding OpenApiKeySetupCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2B8A3E"
                                    FontSize="13"
                                    Cursor="Hand"
                                    ToolTip="Configure AI API Key"
                                    Margin="6,0,0,0"
                                    Padding="0"/>
                        </StackPanel>
                        <Button Content="📄  Scan Bill"
                                Command="{Binding ScanBillCommand}"
                                Height="34" Padding="14,0" Margin="0,4,0,0"
                                Background="#2B8A3E" Foreground="White"
                                FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="{Binding ScanHintText}"
                                   Foreground="#E03131" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding ScanHintVisibility}"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     Print button: wrapped in a StackPanel with an invisible
                     spacer Label matching the same FontSize/FontWeight the
                     other columns' real labels use (e.g. "Purchase Date",
                     "SCAN BARCODE / SEARCH"). Every other column's control
                     sits below a label, which pushes it down by that label's
                     rendered height. Print previously had no label above it,
                     so VerticalAlignment="Bottom" made it visibly sit lower
                     than History/ComboBox/DatePicker/Scan Bill. The blank
                     label reserves that same vertical space, so Print now
                     lines up with the rest of the row's controls.
                     ══════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="6" VerticalAlignment="Top">
                    <Label Content=" " FontSize="11" FontWeight="Bold"/>
                    <Button Content="🖨 Print"
                            Click="PrintOptionsButton_Click"
                            Height="34" Padding="14,0"
                            Background="#495057"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Invoice Items" Grid.Column="0" Margin="0,0,12,0" Background="White">

                <DataGrid x:Name="PurchaseGrid"
                          ItemsSource="{Binding PurchaseItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E9ECEF"
                          CellEditEnding="PurchaseGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                            Width="40" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Barcode"
                                            Binding="{Binding Barcode}"
                                            Width="120"
                                            ElementStyle="{StaticResource BarcodeCellText}"/>

                        <DataGridTextColumn Header="Product Name"
                                            Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Price (₹)"
                                            Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Wholesale (₹)"
                                            Binding="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="115"
                                            ElementStyle="{StaticResource WholesaleCellText}"/>

                        <DataGridTextColumn Header="MRP (₹)"
                                            Binding="{Binding MRP, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="100"
                                            ElementStyle="{StaticResource MrpRetailCellText}"/>

                        <DataGridTextColumn Header="Retail (₹)"
                     Binding="{Binding Retail, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                     Width="100"
                     ElementStyle="{StaticResource MrpRetailCellText}"/>

                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Net Amount (₹)"
                                            Binding="{Binding AfterTaxation, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="130"
                                            ElementStyle="{StaticResource NetAmountCellText}"/>

                        <DataGridTemplateColumn Header="Action" Width="85" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.PurchaseDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#E03131"
                                            Cursor="Hand"
                                            FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Border Grid.Column="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14,10" CornerRadius="8" VerticalAlignment="Stretch">
                <StackPanel Width="280">

                    <Expander Header="Tax Configuration" IsExpanded="False" Margin="0,0,0,5" BorderBrush="#DEE2E6" FontWeight="SemiBold" Foreground="#495057">
                        <StackPanel Margin="8,6" TextElement.FontWeight="Normal">
                            <ComboBox ItemsSource="{Binding TaxCategories}"
                                      SelectedItem="{Binding SelectedTaxCategory}"
                                      Height="28" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CGST, StringFormat=CGST: {0}%}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding SGST, StringFormat=SGST: {0}%}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding IGST, StringFormat=IGST: {0}%}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            
                        </StackPanel>
                    </Expander>

                    <StackPanel>
                        <TextBlock Text="INVOICE SUMMARY" Foreground="#495057" FontWeight="Bold" FontSize="12" Margin="0,5,0,8"/>

                        <DockPanel Margin="0,3">
                            <TextBlock Text="Net Amount" FontSize="12" FontWeight="SemiBold" Foreground="#495057" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:N2}}" FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,3">
                            <TextBlock Text="Discount" FontSize="12" FontWeight="SemiBold" Foreground="#495057" VerticalAlignment="Center"/>
                            <TextBox Width="90" Height="24" TextAlignment="Right" HorizontalAlignment="Right" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <DockPanel Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CGST" FontSize="12" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding CGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="4,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CGSTAmount, StringFormat={}{0:N2}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SGST" FontSize="12" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding SGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="4,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SGSTAmount, StringFormat={}{0:N2}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="IGST" FontSize="12" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding IGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="4,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IGSTAmount, StringFormat={}{0:N2}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Separator Margin="0,8"/>

                        <DockPanel Margin="0,3">
                            <TextBlock Text="Grand Total" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#212529"/>
                            <TextBlock Text="{Binding PurchaseMaster.TotalAmount, StringFormat={}{0:C}}"
                                       FontWeight="ExtraBold" FontSize="18" Foreground="#1971C2" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Separator Margin="0,8"/>



                        <!-- ══════════════════════════════════════════════════════════
                             Edit / Save Invoice / Payment: previously each a
                             full-width Button stacked one under another. Now
                             laid out in a WrapPanel so they sit side by side
                             in a row, sized to their own content instead of
                             stretching to fill the panel width; if they don't
                             all fit on one line, WrapPanel automatically wraps
                             the overflow button down to the next row instead
                             of clipping or squeezing them.
                             ══════════════════════════════════════════════════════════ -->
                        <WrapPanel Margin="0,15,0,0">
                            <Button Content="✏ Edit"
                                    Click="EditProductsButton_Click"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,8"
                                    Background="#F08C00"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="SAVE"
                                    Command="{Binding PurchaseSaveCommand}"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,8"
                                    Background="#1971C2"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Payment"
                                    Click="PaymentButton_Click"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,8"
                                    Background="#E1AD01"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
