<UserControl x:Class="MyWPFCRUDApp.Views.PurchaseViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8"
                Padding="15" Margin="0,0,0,10"
                BorderBrush="#DEE2E6" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="Supplier *" FontSize="11" FontWeight="Bold"/>
                    <DockPanel>
                        <Button Content="+ New"
                                Command="{Binding OpenAddSupplierCommand}"
                                DockPanel.Dock="Right"
                                Padding="10,0" Margin="5,0,0,0"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="SupplierName"
                                  Height="32" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="Invoice Number *" FontSize="11" FontWeight="Bold"/>
                    <TextBox Text="{Binding PurchaseMaster.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <Label Content="Purchase Date" FontSize="11" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding PurchaseMaster.PurchaseDate}"
                                Height="32" Width="130"/>
                </StackPanel>

                <Border Grid.Column="3" Background="#E7F5FF" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                    <StackPanel>
                        <Label Content="SCAN BARCODE / SEARCH" Foreground="#1971C2" FontWeight="ExtraBold" FontSize="10"/>
                        <TextBox x:Name="SearchBox" Height="32"
                                 BorderBrush="#A5D8FF" BorderThickness="2"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding BarcodeSearchCommand}"
                                            CommandParameter="{Binding ElementName=SearchBox, Path=Text}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#EBF8EE" CornerRadius="8" Padding="10,8">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="AI BILL SCAN" Foreground="#2B8A3E"
                                       FontWeight="ExtraBold" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Button Content="⚙"
                                    Command="{Binding OpenApiKeySetupCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2B8A3E"
                                    FontSize="13"
                                    Cursor="Hand"
                                    ToolTip="Configure AI API Key"
                                    Margin="6,0,0,0"
                                    Padding="0"/>
                        </StackPanel>
                        <Button Content="📄  Scan Bill"
                                Command="{Binding ScanBillCommand}"
                                Height="34" Padding="14,0" Margin="0,4,0,0"
                                Background="#2B8A3E" Foreground="White"
                                FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock Text="{Binding ScanHintText}"
                                   Foreground="#E03131" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding ScanHintVisibility}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Invoice Items" Grid.Column="0" Background="White" Margin="0,0,12,0">
                <DataGrid x:Name="PurchaseGrid"
                          ItemsSource="{Binding PurchaseItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E9ECEF"
                          CellEditEnding="PurchaseGrid_CellEditEnding">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                            Width="40" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Barcode"
                                            Binding="{Binding Barcode}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#1971C2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Product Name"
                                            Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Price (₹)"
                                            Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Wholesale (₹)"
                                            Binding="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#2B8A3E"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MRP (₹)"
                                            Binding="{Binding MRP, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#1971C2"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Net Amount (₹)"
                                            Binding="{Binding AfterTaxation, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1971C2"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Action" Width="85" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
        Command="{Binding DataContext.PurchaseDeleteCommand,
                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
        CommandParameter="{Binding}"
        Background="Transparent"
        BorderThickness="0"
        Foreground="#E03131"
        Cursor="Hand"
        FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    Padding="14"
                    CornerRadius="8"
                    VerticalAlignment="Stretch">

                <Grid Width="250">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DISPLAY HISTORY" Foreground="#495057" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding InvoiceHistory}" BorderThickness="0" Background="Transparent" AlternationCount="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="2,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding InvoiceNumber}" FontSize="11" Foreground="#495057" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#1971C2" FontWeight="Bold"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Separator Grid.Row="1" Background="#DEE2E6" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <TextBlock Text="INVOICE SUMMARY" Foreground="#495057" FontWeight="Bold" FontSize="11" Margin="0,0,0,12"/>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="Net Amount" FontWeight="SemiBold" Foreground="#495057"/>
                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:N2}}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="Discount" FontWeight="SemiBold" Foreground="#495057"/>
                            <TextBox Width="100" TextAlignment="Right" HorizontalAlignment="Right"
                                     Text="{Binding Discount,
       UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CGST" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding CGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CGSTAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SGST" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding SGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SGSTAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="IGST" FontWeight="SemiBold" Foreground="#495057"/>
                                <TextBlock Text="{Binding IGSTPercent, StringFormat={} @ {0}%}" FontSize="10" Foreground="#868E96" Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IGSTAmount, StringFormat={}{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Separator Margin="0,10"/>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="Grand Total" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#212529"/>
                            <TextBlock Text="{Binding PurchaseMaster.TotalAmount, StringFormat={}{0:C}}"
                                       FontWeight="ExtraBold" FontSize="20" Foreground="#1971C2" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Separator Margin="0,15"/>

                        <Button Content="SAVE INVOICE"
        Command="{Binding PurchaseSaveCommand}"
        Height="45"
        Margin="0,10,0,0"
        Background="#1971C2"
        Foreground="White"
        FontSize="14"
        FontWeight="Bold"
        Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>