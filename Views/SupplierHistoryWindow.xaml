<Window x:Class="MyWPFCRUDApp.Views.SupplierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase History" Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1971C2" Padding="14,10">
            <TextBlock Text="Purchase History" FontWeight="Bold"
                       FontSize="14" Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6" Background="White">
                            <Expander.Header>
                                <Grid Width="620">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontWeight="Bold" FontSize="13" Foreground="#212529"/>
                                        <TextBlock Text="{Binding PurchaseDate, StringFormat={}{0:dd MMM yyyy}}"
                                                   FontSize="11" Foreground="#868E96"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="0,0,20,0"
                                               Text="{Binding PaymentMode}" FontSize="11"
                                               Foreground="#495057" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Margin="0,0,20,0"
                                               Text="{Binding Discount, StringFormat=Disc: ₹{0:N2}}"
                                               FontSize="11" Foreground="#868E96" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TotalAmount, StringFormat=₹{0:N2}}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="#2F9E44" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4"
                    Content="Open"
                    Command="{Binding DataContext.LoadHistoryInvoiceCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Click="OpenInvoice_Click"
                    Width="60" Height="26"
                    Background="#1971C2" Foreground="White"
                    FontWeight="SemiBold" Cursor="Hand"
                    BorderThickness="0" Margin="0,0,4,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Expander.Header>

                            <!-- Detail lines -->
                            <Border Background="#F8F9FA" BorderBrush="#DEE2E6"
                                    BorderThickness="1" Margin="4,0,4,4">
                                <DataGrid ItemsSource="{Binding Details}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9ECEF"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode"   Binding="{Binding Barcode}"        Width="110"/>
                                        <DataGridTextColumn Header="Product"   Binding="{Binding ProductName}"    Width="*"/>
                                        <DataGridTextColumn Header="Qty"       Binding="{Binding Quantity}"       Width="55"/>
                                        <DataGridTextColumn Header="Purchase"  Binding="{Binding PurchasePrice, StringFormat=₹{0:N2}}" Width="90"/>
                                        <DataGridTextColumn Header="Wholesale" Binding="{Binding WholesalePrice, StringFormat=₹{0:N2}}" Width="90"/>
                                        <DataGridTextColumn Header="Retail"    Binding="{Binding Retail, StringFormat=₹{0:N2}}"        Width="80"/>
                                        <DataGridTextColumn Header="MRP"       Binding="{Binding MRP, StringFormat=₹{0:N2}}"           Width="80"/>
                                        <DataGridTextColumn Header="Amount"    Binding="{Binding AfterTaxation, StringFormat=₹{0:N2}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="EmptyText"
                   Text="No purchases found for this supplier."
                   Foreground="#868E96" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>