<Window x:Class="MyWPFCRUDApp.Views.SupplierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase History" Width="1200" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1971C2" Padding="14,10">
            <TextBlock Text="Purchase History" FontWeight="Bold"
                       FontSize="14" Foreground="White"/>
        </Border>

        <!-- Filter / search panel -->
        <!-- Filter / search panel -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6"
        BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>

                <!-- Row 1: Supplier info + invoice number -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Supplier Name -->
                    <StackPanel Grid.Column="0">
    <TextBlock Text="Supplier Name" FontSize="11" Foreground="#868E96" Margin="0,0,0,4"/>
    <TextBox x:Name="SupplierNameBox"
             Height="30"/>
</StackPanel>

<!-- Supplier ID -->
<StackPanel Grid.Column="2">
    <TextBlock Text="Supplier ID" FontSize="11" Foreground="#868E96" Margin="0,0,0,4"/>
    <TextBox x:Name="SupplierIdBox"
             Height="30"/>
</StackPanel>
                    <!-- Invoice Number -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Invoice Number" FontSize="11" Foreground="#868E96" Margin="0,0,0,4"/>
                        <TextBox x:Name="InvoiceNumberBox"
                 Height="30"/>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="From Date" FontSize="11" Foreground="#868E96" Margin="0,0,0,4"/>
                        <DatePicker x:Name="FromDatePicker"
                    Height="30"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="To Date" FontSize="11" Foreground="#868E96" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ToDatePicker"
                    Height="30"/>
                    </StackPanel>

                    <!-- Check Button -->
                    <!-- Check Button -->
                    <Button Grid.Column="10"
        Content="Check"
        Click="CheckButton_Click"
        Width="90" Height="30"
        VerticalAlignment="Bottom"
        Background="#1971C2" Foreground="White"
        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Grid.Column="12"
        Content="Refresh"
        Click="RefreshButton_Click"
        Width="90" Height="30"
        VerticalAlignment="Bottom"
        Background="#868E96" Foreground="White"
        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Row 2: Date range + Check button -->
                

            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList" Margin="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6"
          Background="White"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch"
      Width="{Binding ActualWidth,
              RelativeSource={RelativeSource AncestorType=Expander}}"
      MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Invoice + Date -->
                                    <StackPanel Grid.Column="0" Margin="4,0,8,0"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="#212529"/>
                                        <TextBlock Text="{Binding PurchaseDate, StringFormat={}{0:dd MMM yyyy}}"
                                           FontSize="12" Foreground="#868E96"
                                           Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Discount -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SUPPLIER ID" FontSize="10"
                                           Foreground="#868E96" FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SupplierId}"
           FontSize="13" Foreground="#868E96" FontWeight="Bold"/>

                                        <!-- SUPPLIER NAME -->
                                        
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="SUPPLIER NAME" FontSize="10"
       Foreground="#868E96" FontWeight="SemiBold"
       Margin="0,0,0,4"/>
                                        

                                        <!-- SUPPLIER NAME -->
                                        <TextBlock Text="{Binding SupplierName}"
           FontSize="13" Foreground="#868E96" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="DISCOUNT" FontSize="10"
       Foreground="#868E96" FontWeight="SemiBold"
       Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Discount, StringFormat=₹{0:N2}}"
       FontSize="13" Foreground="#868E96"
       FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Total -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL" FontSize="10"
                                           Foreground="#868E96" FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#2F9E44"/>
                                    </StackPanel>

                                    <!-- Paid -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock Text="PAID" FontSize="10"
                                           Foreground="#868E96" FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TotalPaid, StringFormat=₹{0:N2}}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#1971C2"/>
                                    </StackPanel>

                                    <!-- Remaining -->
                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="REMAINING" FontSize="10"
                                           Foreground="#868E96" FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding RemainingAmount, StringFormat=₹{0:N2}}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{Binding RemainingColor}"/>
                                    </StackPanel>

                                    <!-- Open button -->
                                    <Button Grid.Column="7"
                                    Content="Open"
                                    Command="{Binding DataContext.LoadHistoryInvoiceCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Click="OpenInvoice_Click"
                                    Width="70" Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#1971C2" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12"
                                    Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Expander.Header>

                            <!-- Detail lines -->
                            <Border Background="#F8F9FA" BorderBrush="#DEE2E6"
                            BorderThickness="1" Margin="4,0,4,4">
                                <DataGrid ItemsSource="{Binding Details}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9ECEF"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode"
                                    Binding="{Binding Barcode}" Width="110"/>
                                        <DataGridTextColumn Header="Product"
                                    Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Quantity}" Width="55"/>
                                        <DataGridTextColumn Header="Purchase"
                                    Binding="{Binding PurchasePrice, StringFormat=₹{0:N2}}" Width="90"/>
                                        <DataGridTextColumn Header="Wholesale"
                                    Binding="{Binding WholesalePrice, StringFormat=₹{0:N2}}" Width="90"/>
                                        <DataGridTextColumn Header="Retail"
                                    Binding="{Binding Retail, StringFormat=₹{0:N2}}" Width="80"/>
                                        <DataGridTextColumn Header="MRP"
                                    Binding="{Binding MRP, StringFormat=₹{0:N2}}" Width="80"/>
                                        <DataGridTextColumn Header="Amount"
                                    Binding="{Binding AfterTaxation, StringFormat=₹{0:N2}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="EmptyText"
                   Text="No purchases found for this supplier."
                   Foreground="#868E96" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
