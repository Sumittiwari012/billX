<UserControl x:Class="MyWPFCRUDApp.Views.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: transfer list ================= -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="150" Margin="0,0,8,0"/>
                <Button Content="+ New transfer" Command="{Binding NewCommand}" Padding="10,2"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Search" Command="{Binding RefreshCommand}" Padding="10,2"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Transfers}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding TransferNo}" Width="85"/>
                    <DataGridTextColumn Header="From" Binding="{Binding FromDisplay}" Width="*"/>
                    <DataGridTextColumn Header="To" Binding="{Binding ToDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                    <DataGridTextColumn Header="Lines" Binding="{Binding ItemCount}" Width="45"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ================= RIGHT: editor ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- Header: editable only while Draft -->
            <Grid Grid.Row="1" IsEnabled="{Binding IsDraft}" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="From" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LocationTypes}" SelectedItem="{Binding FromType}" Margin="0,0,6,4"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding FromLocations}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding FromId}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Text="To" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LocationTypes}" SelectedItem="{Binding ToType}" Margin="0,0,6,4"/>
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ToLocations}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding ToId}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Text="Remarks" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Scan row: add barcodes (draft) or tick off received barcodes (dispatched) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding ShowScan, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Scan barcode" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ScanBarcode, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Qty" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ScanQty, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,8,0"/>
                <Button Content="Add" Command="{Binding AddItemCommand}" Width="60"/>
            </StackPanel>

            <!-- Lines: draft grid and receipt grid share the same cell -->
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" IsReadOnly="True" Width="130"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="At source" Binding="{Binding SourceQty, StringFormat=N3}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Qty to send" Binding="{Binding DispatchedQty, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Padding="4,0"
                                            Command="{Binding DataContext.RemoveItemCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" IsReadOnly="{Binding ReceiptGridReadOnly}"
                          Visibility="{Binding IsNotDraft, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" IsReadOnly="True" Width="130"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Sent" Binding="{Binding DispatchedQty, StringFormat=N3}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQty, UpdateSourceTrigger=LostFocus}" Width="80"/>
                        <DataGridTextColumn Header="Short" Binding="{Binding Shortage, StringFormat=N3}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <!-- Dispatch bill: Standard (built-in, with terms & conditions) or Custom (your own template) -->
                <WrapPanel Margin="0,0,0,8"
                           Visibility="{Binding CanPrintBill, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Dispatch bill" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <ComboBox ItemsSource="{Binding BillFormats}" SelectedItem="{Binding BillFormat}" Width="100" Margin="0,0,8,4"/>
                    <Button Content="Print / Preview bill" Command="{Binding PrintBillCommand}" Padding="12,4" Margin="0,0,8,4"/>
                    <Button Content="Edit terms" Command="{Binding EditTermsCommand}" Padding="12,4" Margin="0,0,8,4"/>
                    <Button Content="Edit custom template" Command="{Binding EditTemplateCommand}" Padding="12,4" Margin="0,0,8,4"/>
                    <Button Content="Set signature..." Command="{Binding SetSignatureCommand}" Padding="12,4" Margin="0,0,8,4"/>
                    <Button Content="Remove signature" Command="{Binding RemoveSignatureCommand}" Padding="12,4" Margin="0,0,8,4"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                    <Button Content="Save draft" Command="{Binding SaveDraftCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Dispatch" Command="{Binding DispatchCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Delete draft" Command="{Binding DeleteDraftCommand}" Padding="12,4"
                            Visibility="{Binding CanDeleteDraft, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsDispatched, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Rejection reason" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ActionRemarks, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Receive all as sent" Command="{Binding ReceiveAllCommand}" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="Confirm receipt" Command="{Binding ConfirmReceiptCommand}" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="Reject shipment" Command="{Binding RejectCommand}" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="Cancel dispatch" Command="{Binding CancelDispatchCommand}" Padding="12,4"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPartial, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Shortage open:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Return shortage to source" Command="{Binding ResolveShortageCommand}"
                            CommandParameter="return" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Write off shortage" Command="{Binding ResolveShortageCommand}"
                            CommandParameter="writeoff" Padding="12,4"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>