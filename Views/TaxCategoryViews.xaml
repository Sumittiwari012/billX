<UserControl x:Class="MyWPFCRUDApp.Views.TaxCategoryViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="GhostWhite">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Available Tax Configurations" Margin="5">
            <StackPanel Margin="10">

                <Label Content="Select Tax Configuration"
               FontWeight="SemiBold"/>

                <ComboBox ItemsSource="{Binding TaxCategory}"
                  SelectedItem="{Binding SelectedTaxCategory}"
                  Height="65"
                  Margin="0,0,0,20">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding CGST, StringFormat=CGST : {0}%}" />
                                <TextBlock Text="{Binding SGST, StringFormat=SGST : {0}%}" />
                                <TextBlock Text="{Binding IGST, StringFormat=IGST : {0}%}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                
                <Border BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">

                    <StackPanel>

                        <TextBlock FontWeight="Bold"
                           Margin="0,0,0,10"
                           Text="Selected Configuration"/>

                        <TextBlock Text="{Binding SelectedTaxCategory.CGST,
                          StringFormat=CGST : {0}%}"
                           Margin="0,3"/>

                        <TextBlock Text="{Binding SelectedTaxCategory.SGST,
                          StringFormat=SGST : {0}%}"
                           Margin="0,3"/>

                        <TextBlock Text="{Binding SelectedTaxCategory.IGST,
                          StringFormat=IGST : {0}%}"
                           Margin="0,3"/>

                    </StackPanel>

                </Border>

            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Column="1" Margin="10">
            <GroupBox Header="Tax Configuration"
          Padding="10">

                <StackPanel>

                    <Label Content="CGST (%)"/>
                    <TextBox Height="28"
                 Margin="0,0,0,10"
                 Text="{Binding MTaxCategory.CGST,
                                UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="SGST (%)"/>
                    <TextBox Height="28"
                 Margin="0,0,0,10"
                 Text="{Binding MTaxCategory.SGST,
                                UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="IGST (%)"/>
                    <TextBox Height="28"
                 Margin="0,0,0,20"
                 Text="{Binding MTaxCategory.IGST,
                                UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Save Tax"
                Command="{Binding TaxSaveCommand}"
                Height="35"
                Margin="0,5"
                Background="#FF007ACC"
                Foreground="White"
                FontWeight="Bold"/>

                    <Button Content="Reset"
                Command="{Binding TaxResetCommand}"
                Height="30"
                Margin="0,5"/>

                    <Button Content="Delete Selected"
                Command="{Binding TaxDeleteCommand}"
                Height="30"
                Margin="0,5"
                Background="#FFFFEBEB"
                Foreground="DarkRed"/>

                </StackPanel>

            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>