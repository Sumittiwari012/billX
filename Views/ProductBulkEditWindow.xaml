<Window x:Class="MyWPFCRUDApp.Views.ProductBulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Products"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F3F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Column picker -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar: bulk apply + add copies -->
            <RowDefinition Height="*"/>      <!-- Grid -->
            <RowDefinition Height="Auto"/>   <!-- Save/Cancel -->
        </Grid.RowDefinitions>

        <!-- ══════════════ COLUMN PICKER ══════════════ -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12"
                BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="COLUMNS SHOWN" FontWeight="Bold" FontSize="11"
                           Foreground="#495057" Margin="0,0,0,8"/>
                <ItemsControl x:Name="ColumnPickerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Header}"
                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      Checked="ColumnCheck_Changed"
                                      Unchecked="ColumnCheck_Changed"
                                      Margin="0,0,16,6" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══════════════ TOOLBAR: BULK APPLY + ADD COPIES ══════════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12"
                BorderBrush="#DEE2E6" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">

                <!-- Select all / Unselect all -->
                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                    <Button Content="Select All"
                            Click="SelectAllButton_Click"
                            Height="30" Padding="10,0"
                            Background="White" BorderBrush="#CED4DA"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Unselect All"
                            Click="UnselectAllButton_Click"
                            Height="30" Padding="10,0"
                            Background="White" BorderBrush="#CED4DA">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#DEE2E6" Margin="0,0,30,0"/>

                <!-- Bulk apply -->
                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                    <TextBlock Text="Bulk apply:" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboBulkField" Width="150" Height="30"
                              SelectionChanged="ComboBulkField_SelectionChanged"
                              Margin="0,0,8,0"/>

                    <!-- Free-text value (shown for most fields) -->
                    <TextBox x:Name="TxtBulkValue" Width="130" Height="30"
                             VerticalContentAlignment="Center" Padding="6,0"
                             Margin="0,0,8,0"/>

                    <!-- Dropdown value (shown for Category/SubCategory/Unit) -->
                    <ComboBox x:Name="ComboBulkValue" Width="150" Height="30"
                              Visibility="Collapsed" Margin="0,0,8,0"/>

                    <!-- Per-tax value inputs (shown only for the clubbed
                         "Tax Rate (CGST + SGST + IGST)" option — one field
                         each, still applied together via a single Apply
                         click). Leave a field blank to leave that tax
                         untouched on the selected rows. -->
                    <StackPanel x:Name="PanelBulkTaxRates" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBlock Text="CGST%" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtBulkCGST" Width="55" Height="30"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <TextBlock Text="SGST%" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtBulkSGST" Width="55" Height="30"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IGST%" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtBulkIGST" Width="55" Height="30"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Apply to Selected ✓"
                            Click="ApplyBulk_Click"
                            Height="30" Padding="10,0"
                            Background="#1971C2" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#DEE2E6" Margin="0,0,30,0"/>

                <!-- Delete selected -->
                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                    <Button Content="🗑 Delete Selected"
                            Click="DeleteSelected_Click"
                            Height="30" Padding="10,0"
                            Background="#E03131" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Separator Width="1" Background="#DEE2E6" Margin="0,0,30,0"/>

                <!-- Add copies (variety, blank Size/Colour) -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Copies:" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtCopyCount" Width="50" Height="30" Text="1"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>
                    <Button Content="+ Add Copies of Selected"
                            Click="AddCopies_Click"
                            Height="30" Padding="10,0"
                            Background="#0CA678" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <TextBlock Text="Tip: check rows using the ✓ column (click-drag to paint multiple), or use Select All / Unselect All, then use any action above. Deletes are applied when you click Save."
                           Foreground="#868E96" FontSize="11" VerticalAlignment="Center"
                           Margin="30,0,0,0" TextWrapping="Wrap" MaxWidth="240"/>
            </StackPanel>
        </Border>

        <!-- ══════════════ GRID ══════════════ -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#DEE2E6" BorderThickness="1">
            <DataGrid x:Name="ProductGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      AlternatingRowBackground="#F8F9FA"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E9ECEF"
                      RowHeaderWidth="0"
                      PreviewMouseMove="ProductGrid_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="ProductGrid_PreviewMouseLeftButtonUp">
                <DataGrid.Columns>

                    <!-- Select (always visible) — header checkbox does
                         select-all / unselect-all (tri-state: dash means a
                         mix of selected/unselected rows). Each cell checkbox
                         supports click-and-drag painting across rows. -->
                    <DataGridTemplateColumn x:Name="SelectColumn" Width="36">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="ChkSelectAll"
                                      IsThreeState="True"
                                      Click="SelectAll_Click"
                                      ToolTip="Select / unselect all"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- New/Existing badge -->
                    <DataGridTextColumn Header="Status" Width="70" IsReadOnly="True"
                                         Binding="{Binding StatusLabel}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Always visible -->
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Product.Barcode}" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="ProductName" Binding="{Binding Product.ProductName}" Width="180"/>

                    <!-- Toggleable text columns -->
                    <DataGridTextColumn Header="ProductCode" Binding="{Binding Product.ProductCode}" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="HSNCode" Binding="{Binding Product.HSNCode}" Width="90"/>
                    <DataGridTextColumn Header="PartGroup" Binding="{Binding Product.PartGroup}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Product.Description}" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="PurchasePrice" Binding="{Binding Product.PurchasePrice, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="RetailSalePrice" Binding="{Binding Product.RetailSalePrice, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="WholesalePrice" Binding="{Binding Product.WholesalePrice, StringFormat={}{0:N2}}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="MRP" Binding="{Binding Product.MRP, StringFormat={}{0:N2}}" Width="90" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="DiscountPercentage" Binding="{Binding Product.DiscountPercentage}" Width="80" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="CGST" Binding="{Binding Product.CGST}" Width="70"/>
                    <DataGridTextColumn Header="SGST" Binding="{Binding Product.SGST}" Width="70"/>
                    <DataGridTextColumn Header="IGST" Binding="{Binding Product.IGST}" Width="70"/>
                    <DataGridTextColumn Header="CESS" Binding="{Binding Product.CESS}" Width="70" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Godown" Binding="{Binding Product.Godown}" Width="90" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Rack" Binding="{Binding Product.Rack}" Width="80" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Batch" Binding="{Binding Product.Batch}" Width="90" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="MfgDate" Binding="{Binding Product.MfgDate, StringFormat=dd-MMM-yyyy}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="ExpDate" Binding="{Binding Product.ExpDate, StringFormat=dd-MMM-yyyy}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Product.Size}" Width="70"/>
                    <DataGridTextColumn Header="Colour" Binding="{Binding Product.Colour}" Width="80"/>
                    <DataGridTextColumn Header="IMEI1" Binding="{Binding Product.IMEI1}" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="IMEI2" Binding="{Binding Product.IMEI2}" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80" />

                    <!-- Category / SubCategory / Unit — dropdown editors -->
                    <DataGridTemplateColumn Header="Category" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CategoryName}" Margin="6,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Categories,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="CategoryName" SelectedValuePath="Id"
                                          SelectedValue="{Binding Product.CategoryId, Mode=TwoWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SubCategory" Width="130" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SubCategoryName}" Margin="6,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.SubCategories,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="SubCategoryName" SelectedValuePath="Id"
                                          SelectedValue="{Binding Product.SubCategoryId, Mode=TwoWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Unit" Width="100" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UnitName}" Margin="6,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Units,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="UnitName" SelectedValuePath="Id"
                                          SelectedValue="{Binding Product.UnitId, Mode=TwoWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════ SAVE / CANCEL ══════════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    Width="100" Height="38" Margin="0,0,10,0"
                    Background="White" BorderBrush="#CED4DA"/>
            <Button Content="Save All Changes" Click="Save_Click"
                    Width="170" Height="38"
                    Background="#2F9E44" Foreground="White"
                    FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
