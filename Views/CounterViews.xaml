<UserControl x:Class="MyWPFCRUDApp.Views.CounterViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyWPFCRUDApp.Views"
             Background="AliceBlue"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT: Counters (master) ===================== -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Registered Counters" Grid.Row="0">
                <DataGrid ItemsSource="{Binding Counters}"
                          SelectedItem="{Binding SelectedCounter}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Counter Name" Binding="{Binding CounterName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Counter Details" Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Margin="5">
                    <Label Content="Counter Name*"/>
                    <TextBox Text="{Binding CurrentCounter.CounterName, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Reset" Command="{Binding CounterResetCommand}" Width="90" Height="30" Margin="5"/>
                        <Button Content="Delete" Command="{Binding CounterDeleteCommand}" Width="90" Height="30" Margin="5" Background="#FFFFEBEB" Foreground="DarkRed"/>
                        <Button Content="Save" Command="{Binding CounterSaveCommand}" Width="110" Height="30" Margin="5" Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ===================== RIGHT: Users assigned to selected Counter (detail) ===================== -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0">
                <GroupBox.Header>
                    <TextBlock>
                        <Run Text="Users assigned to: "/>
                        <Run Text="{Binding SelectedCounter.CounterName, FallbackValue=(select a counter), TargetNullValue=(select a counter)}" FontWeight="Bold"/>
                    </TextBlock>
                </GroupBox.Header>
                <DataGrid x:Name="CounterUsersGrid"
                          ItemsSource="{Binding CounterUsers}"
                          SelectedItem="{Binding SelectedCounterUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="CounterUsersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Assign / Edit Counter User" Grid.Row="1" Margin="0,10,0,0"
                      IsEnabled="{Binding IsCounterSelected}">
                <StackPanel Margin="5">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="5">
                            <Label Content="User*"/>
                            <ComboBox ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser}"
                                      DisplayMemberPath="UserName"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <Label Content="Password*"/>
                            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,5,0">
                        <Button Content="Reset" Command="{Binding CounterUserResetCommand}" Width="90" Height="30" Margin="5"/>
                        <Button Content="Remove" Command="{Binding CounterUserDeleteCommand}" Width="90" Height="30" Margin="5" Background="#FFFFEBEB" Foreground="DarkRed"/>
                        <Button Content="Save" Command="{Binding CounterUserSaveCommand}" Width="110" Height="30" Margin="5" Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
