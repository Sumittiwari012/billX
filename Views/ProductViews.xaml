<UserControl x:Class="MyWPFCRUDApp.Views.ProductViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400"
             Background="#FFFDF8F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             ROW 0 · Column Visibility Expander
        ═══════════════════════════════════════════════ -->
        <Expander Grid.Row="0"
                  Header="⚙ Choose Visible Columns"
                  Margin="0,0,0,6"
                  IsExpanded="False"
                  Background="#FFF8F1E7"
                  BorderBrush="#FFD6C4A7"
                  BorderThickness="1">
            <Border Background="#FFFDF8F0" Padding="10,6">
                <ItemsControl ItemsSource="{Binding ProductColumns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Header}"
                                      IsChecked="{Binding IsVisible}"
                                      Margin="10,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Expander>

        <!-- ═══════════════════════════════════════════════
             ROW 1 · Entry / Edit Row
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FFF8F1E7"
                BorderBrush="#FFD6C4A7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header Row -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Barcode"      Width="120" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Product Code" Width="120" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Product Name" Width="180" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Category"     Width="150" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="SubCategory"  Width="150" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Purchase Price" Width="120" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Sale"         Width="100" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="MRP"          Width="100" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="CGST"         Width="80"  Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="SGST"         Width="80"  Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="IGST"         Width="80"  Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Unit"         Width="120" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Size"         Width="80"  Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Quantity"     Width="90"  Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Colour"       Width="100" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="Rack"         Width="100" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="HSN Code"     Width="100" Margin="5" FontWeight="Bold"/>
                        <TextBlock Text="DiscountPercentage" Width="100" Margin="5" FontWeight="Bold"/>
                    </StackPanel>
                    <!-- Entry Controls Row -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="120" Margin="5" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="120" Margin="5" Text="{Binding MProduct.ProductCode, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="180" Margin="5" Text="{Binding MProduct.ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Width="150" Margin="5" ItemsSource="{Binding Categories}"          SelectedItem="{Binding SelectedCategory}"    DisplayMemberPath="CategoryName"/>
                        <ComboBox Width="150" Margin="5" ItemsSource="{Binding FilteredSubCategories}" SelectedItem="{Binding SelectedSubCategory}" DisplayMemberPath="SubCategoryName"/>
                        <TextBox Width="120" Margin="5" Text="{Binding MProduct.PurchasePrice, StringFormat=0.00, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.RetailSalePrice, StringFormat=0.00, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.MRP, StringFormat=0.00, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="80"  Margin="5" Text="{Binding MProduct.CGST}"/>
                        <TextBox Width="80"  Margin="5" Text="{Binding MProduct.SGST}"/>
                        <TextBox Width="80"  Margin="5" Text="{Binding MProduct.IGST}"/>
                        <ComboBox Width="120" Margin="5" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="UnitName"/>
                        <TextBox Width="80"  Margin="5" Text="{Binding MProduct.Size}"/>
                        <TextBox Width="90"  Margin="5" Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.Colour}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.Rack}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.HSNCode}"/>
                        <TextBox Width="100" Margin="5" Text="{Binding MProduct.DiscountPercentage}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 1B · Price Auto-Calculation Section
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#FFF0E8DC"
                BorderBrush="#FFDFCFB8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8"/>

        <!-- ═══════════════════════════════════════════════
             ROW 2 · Multi-select notice bar (bulk column update)
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                Background="#FFFFEEBA"
                BorderBrush="#FFC8A400"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                Margin="0,0,0,6"
                Visibility="{Binding MultiSelectBarVisibility}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedCountText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Content="⚙ Update Columns"
                        Click="UpdateColumnsButton_Click"
                        Background="#FF1F3A5F"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="8,3"
                        Margin="0,0,12,0"/>
                <Button Content="✖ Clear Selection"
                        Command="{Binding ClearSelectionCommand}"
                        Background="#FFEEEEEE"
                        Padding="8,3"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ROW 3 · Products DataGrid
        ═══════════════════════════════════════════════ -->
        <DataGrid x:Name="ProductDataGrid"
          Grid.Row="3"
          ItemsSource="{Binding Products}"
          SelectedItem="{Binding SelectedProduct}"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Extended"
          AlternatingRowBackground="#FFF8F4EE"
          RowBackground="White"
          GridLinesVisibility="Horizontal"
          BorderBrush="#FFE0D5C4"
          BorderThickness="1">

            <DataGrid.Columns>

                <!-- Checkbox column for multi-select (always visible) -->
                <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DataContext.AllSelected,
                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      ToolTip="Select / deselect all"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Print column (always visible, last) -->
                <DataGridTemplateColumn Header="🖨 Print" Width="70" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Print"
                                    Tag="{Binding}"
                                    Click="PrintRowButton_Click"
                                    Background="#FFE8F4FD"
                                    Foreground="#FF1565C0"
                                    FontSize="11"
                                    Padding="4,2"
                                    Margin="2"
                                    Cursor="Hand"
                                    ToolTip="Print barcode label for this product"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Data columns (visibility bound to ProductColumns) -->
                <DataGridTextColumn x:Name="ColBarcode"     Header="Barcode"      Binding="{Binding Barcode}"          Width="120"/>
                <DataGridTextColumn x:Name="ColCode"        Header="Code"         Binding="{Binding ProductCode}"      Width="120"/>
                <DataGridTextColumn x:Name="ColName"        Header="Product Name" Binding="{Binding ProductName}"      Width="200"/>
                <DataGridTextColumn x:Name="ColCategory"    Header="Category"     Binding="{Binding CategoryName}"     Width="150"/>
                <DataGridTextColumn x:Name="ColSubCategory" Header="SubCategory"  Binding="{Binding SubCategoryName}"  Width="150"/>

                <!-- ══════════════════════════════════════════════════════════
                     Quantity — small ▾ button beside the qty textbox opens a
                     centered modal overlay (HistoryOverlay, defined at the
                     end of this Grid) showing every purchase batch behind
                     this product's stock, laid out with real column headers.
                     ══════════════════════════════════════════════════════════ -->
                <DataGridTemplateColumn x:Name="ColQuantity" Header="Quantity" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="55" Margin="0,0,4,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Width="22" Height="22"
                                        Padding="0"
                                        Tag="{Binding}"
                                        Click="PurchaseHistoryButton_Click"
                                        ToolTip="View purchase history"
                                        Background="#F1F3F5"
                                        BorderBrush="#CED4DA"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Path Data="M0,0 L4,4 L8,0 Z" Fill="#495057"
                                          Width="8" Height="4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColPurchase"    Header="Purchase"     Binding="{Binding PurchasePrice}"    Width="100"/>
                <DataGridTextColumn x:Name="ColSale"        Header="Sale"         Binding="{Binding RetailSalePrice}"  Width="100"/>
                <DataGridTextColumn x:Name="ColMRP"         Header="MRP"          Binding="{Binding MRP}"              Width="100"/>
                <DataGridTextColumn x:Name="ColCGST"        Header="CGST"         Binding="{Binding CGST}"             Width="80"/>
                <DataGridTextColumn x:Name="ColSGST"        Header="SGST"         Binding="{Binding SGST}"             Width="80"/>
                <DataGridTextColumn x:Name="ColIGST"        Header="IGST"         Binding="{Binding IGST}"             Width="80"/>
                <DataGridTextColumn x:Name="ColUnit"        Header="Unit"         Binding="{Binding UnitName}"         Width="100"/>
                <DataGridTextColumn x:Name="ColSize"        Header="Size"         Binding="{Binding Size}"             Width="80"/>
                <DataGridTextColumn x:Name="ColColour"      Header="Colour"       Binding="{Binding Colour}"           Width="100"/>
                <DataGridTextColumn x:Name="ColRack"        Header="Rack"         Binding="{Binding Rack}"             Width="100"/>
                <DataGridTextColumn x:Name="ColHSN"         Header="HSN"          Binding="{Binding HSNCode}"          Width="100"/>
                <DataGridTextColumn x:Name="Coldis"         Header="DiscountPercentage"          Binding="{Binding DiscountPercentage}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════
             ROW 4 · Action Buttons
        ═══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="🖨 Print Selected"
        Click="PrintSelectedButton_Click"
        Width="140" Height="35" Margin="5"
        Background="#FFE8F4FD"
        Foreground="#FF1565C0"
        FontWeight="Bold"/>
            <Button Content="🔍 Filter"
        Click="FilterButton_Click"
        Width="100" Height="35" Margin="5"
        Background="#FFEFEFEF"/>

            <Button Content="✖ Clear Filter"
        Click="ClearFilterButton_Click"
        Width="120" Height="35" Margin="5"
        Background="#FFFFE5E5"
        Foreground="DarkRed"
        Visibility="{Binding ClearFilterVisibility}"/>
            <Button Content="Reset"
                    Command="{Binding ProductResetCommand}"
                    Width="100" Height="35" Margin="5"
                    Background="#FFF8EFD8"/>

            <Button Content="Delete"
                    Command="{Binding ProductDeleteCommand}"
                    Width="100" Height="35" Margin="5"
                    Background="#FFFFE5E5"
                    Foreground="DarkRed"/>

            <Button Content="📤 Export to Excel"
                    Command="{Binding ExportExcelCommand}"
                    Width="140" Height="35" Margin="5"
                    Background="#FF217346"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button Content="Save Product"
                    Command="{Binding ProductSaveCommand}"
                    Width="140" Height="35" Margin="5"
                    Background="#FF1F3A5F"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button Content="Import from Excel"
                    Command="{Binding ImportExcelCommand}"
                    Background="#FF27AE60"
                    Foreground="White"
                    Width="140" Height="35" Margin="5"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════
             CENTERED MODAL OVERLAY · Purchase History
             Spans every row so it sits on top of the whole page and
             centers regardless of scroll position in the grid below.
             DataContext is set to the clicked row's ProductDisplayModel
             from code-behind (PurchaseHistoryButton_Click).
             Includes a sort bar (field + direction) and a Save Order
             button that persists the new order to the database.
        ═══════════════════════════════════════════════ -->
        <Grid x:Name="HistoryOverlay"
              Grid.Row="0" Grid.RowSpan="5"
              Background="#88000000"
              Visibility="Collapsed"
              MouseDown="HistoryOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="10"
                    Padding="22"
                    Width="880"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="HistoryCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Purchase History" FontSize="20" FontWeight="Bold" Foreground="#212529"/>
                        <Button Content="✖"
                                Click="CloseHistoryOverlay_Click"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#495057"
                                Cursor="Hand"
                                Padding="6,0"/>
                    </Grid>
                    <TextBlock Text="{Binding ProductName}" FontSize="14" Foreground="#868E96" Margin="0,0,0,14"/>

                    <TextBlock Text="No purchase history recorded yet."
                               FontSize="15" FontStyle="Italic" Foreground="#868E96" Margin="0,10,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PurchaseBatches.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PurchaseBatches.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Sort bar -->
                        <Border Background="#F1F3F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort by" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SortFieldCombo" Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="Invoice Number"  Tag="InvoiceNumber"/>
                                    <ComboBoxItem Content="Supplier"        Tag="SupplierName"/>
                                    <ComboBoxItem Content="Quantity"        Tag="Quantity"/>
                                    <ComboBoxItem Content="Batch"           Tag="Batch"/>
                                    <ComboBoxItem Content="Purchase Price"  Tag="PurchasePrice"/>
                                    <ComboBoxItem Content="Mfg Date"        Tag="MfgDate"/>
                                    <ComboBoxItem Content="Exp Date"        Tag="ExpDate"/>
                                </ComboBox>
                                <ComboBox x:Name="SortDirectionCombo" Width="120" Margin="8,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Ascending"  Tag="asc"/>
                                    <ComboBoxItem Content="Descending" Tag="desc"/>
                                </ComboBox>
                                <Button Content="Apply Sort" Click="ApplySortButton_Click"
                                        Margin="10,0,0,0" Padding="12,3"
                                        Background="#FFE8F4FD" Foreground="#FF1565C0" FontWeight="SemiBold"/>
                                <Button x:Name="SaveOrderButton" Content="💾 Save Order"
                                        Click="SaveOrderButton_Click" IsEnabled="False"
                                        Margin="8,0,0,0" Padding="12,3"
                                        Background="#FF1F3A5F" Foreground="White" FontWeight="Bold"/>
                                <Button x:Name="ResetOrderButton" Content="↺ Reset Order"
                                        Click="ResetOrderButton_Click" IsEnabled="False"
                                        Margin="8,0,0,0" Padding="12,3"
                                        Background="#FFFFE5E5" Foreground="DarkRed" FontWeight="SemiBold"
                                        ToolTip="Undo all reordering and go back to the last saved order"/>
                            </StackPanel>
                        </Border>

                        <!-- Column header row -->
                        <Border Background="#1F3A5F" CornerRadius="6,6,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Move"     FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="Invoice"  FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="Batch"    FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Grid.Column="3" Text="Mfg Date" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Grid.Column="4" Text="Exp Date" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Grid.Column="5" Text="Qty"      FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="Price"    FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="Supplier" FontWeight="Bold" FontSize="14" Foreground="White" Margin="14,0,0,0"/>
                            </Grid>
                        </Border>

                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PurchaseBatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Move up / down -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="▲" Tag="{Binding}" Click="MoveBatchUp_Click"
                                                            Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                                            FontSize="11" Background="#F1F3F5"
                                                            BorderBrush="#CED4DA" BorderThickness="1"
                                                            Cursor="Hand" ToolTip="Move up"/>
                                                    <Button Content="▼" Tag="{Binding}" Click="MoveBatchDown_Click"
                                                            Width="24" Height="24" Padding="0"
                                                            FontSize="11" Background="#F1F3F5"
                                                            BorderBrush="#CED4DA" BorderThickness="1"
                                                            Cursor="Hand" ToolTip="Move down"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="#1971C2"
                                                           Text="{Binding InvoiceNumber, TargetNullValue=Opening Stock}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" FontSize="14" Foreground="#495057"
                                                           Text="{Binding Batch, TargetNullValue=—}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" FontSize="14" Foreground="#495057"
                                                           Text="{Binding MfgDate, StringFormat=dd-MMM-yyyy, TargetNullValue=—}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" FontSize="14" Foreground="#495057"
                                                           Text="{Binding ExpDate, StringFormat=dd-MMM-yyyy, TargetNullValue=—}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" FontSize="15" FontWeight="Bold" Foreground="#212529"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding Quantity, StringFormat=N2}"/>
                                                <TextBlock Grid.Column="6" FontSize="15" FontWeight="Bold" Foreground="#2B8A3E"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding PurchasePrice, StringFormat=₹{0:N2}}"/>
                                                <TextBlock Grid.Column="7" FontSize="14" Foreground="#495057"
                                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding SupplierName, TargetNullValue=—}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
