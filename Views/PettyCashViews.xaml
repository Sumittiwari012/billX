<UserControl x:Class="MyWPFCRUDApp.Views.PettyCashViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyWPFCRUDApp.Views"
             xmlns:helpers="clr-namespace:MyWPFCRUDApp.Helpers"
             Background="AliceBlue"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Petty Cash Entries" Margin="5">
            <DataGrid ItemsSource="{Binding PettyCashEntries}" 
                      SelectedItem="{Binding SelectedEntry}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Counter" Binding="{Binding CounterName}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding PettyCash, StringFormat=₹{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Accept}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5">
            <StackPanel>
                <GroupBox Header="Petty Cash Details" Margin="0,0,0,10">
                    <UniformGrid Columns="2" Margin="5">
                        <StackPanel Margin="5">
                            <Label Content="Counter*"/>
                            <ComboBox ItemsSource="{Binding Counters}"
                                      SelectedItem="{Binding SelectedCounter}"
                                      DisplayMemberPath="CounterName"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <Label Content="Date*"/>
                            <DatePicker SelectedDate="{Binding CurrentEntry.Date}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <Label Content="Amount*"/>
                            <TextBox Text="{Binding CurrentEntry.PettyCash, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                    </UniformGrid>
                </GroupBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,20">
                    <Button Content="Reset" Command="{Binding PettyCashResetCommand}" Width="90" Height="30" Margin="5"/>
                    <Button Content="Delete" Command="{Binding PettyCashDeleteCommand}" Width="90" Height="30" Margin="5" Background="#FFFFEBEB" Foreground="DarkRed"/>
                    <Button Content="Save" Command="{Binding PettyCashSaveCommand}" Width="130" Height="30" Margin="5" Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>