<Window x:Class="MyWPFCRUDApp.Views.BarcodeLabelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Barcode Labels"
        Width="1150" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF8F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Barcode Labels for this Invoice"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════ LEFT: column picker + item grid ══════════════════ -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E0D5C4" BorderThickness="1"
                        CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Columns to show:" FontWeight="SemiBold" FontSize="11"
                                   Foreground="#495057" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="ColumnPicker">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Header}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2,14,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Select All / Unselect All — rows start unselected by default
                     (see BuildRow in code-behind), these give a quick way to
                     bulk-select instead of checking every "Print?" box by hand.
                     "Reset Print Qty" restores Print Qty back to the invoice
                     quantity for every row, undoing any manual edits at once. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Select All" Padding="8,4" Margin="0,0,6,0" Click="SelectAllButton_Click"/>
                    <Button Content="Unselect All" Padding="8,4" Margin="0,0,6,0" Click="UnselectAllButton_Click"/>
                    <Button Content="Reset Print Qty" Padding="8,4" Click="ResetPrintQuantityButton_Click"/>
                    <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="11" Foreground="#868E96"/>
                </StackPanel>

                <DataGrid Grid.Row="2"
                          x:Name="LabelsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F4EE"
                          BorderBrush="#E0D5C4" BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="LabelsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <!-- Mandatory base columns — always present.
                             NOTE: grid-level IsReadOnly was removed above —
                             it disabled editing on every column including
                             this checkbox, which is why individual rows
                             couldn't be toggled by clicking (only the
                             Select All / Unselect All buttons worked, since
                             those set IsSelected in code-behind, bypassing
                             the UI edit lock). Read-only is now applied only
                             to the columns below that should stay display-only. -->
                        <DataGridCheckBoxColumn Header="Print?"
                                                 Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="55"/>

                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1971C2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Read-only reference: what the invoice actually recorded. -->
                        <DataGridTextColumn Header="Inv. Qty" Binding="{Binding Quantity}" Width="65" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#868E96"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Editable: how many labels to actually print for this row.
                             Defaults to Inv. Qty (see BuildRow) but the user can lower
                             it — e.g. only 5 of 20 units still need a fresh barcode —
                             without that meaning fewer units were purchased. -->
                        <DataGridTextColumn Header="Print Qty"
                                             Binding="{Binding PrintQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             Width="75" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Optional columns are inserted here at runtime, in
                             code-behind, as each checkbox in ColumnPicker is
                             checked — see AddOptionalColumn/RemoveOptionalColumn. -->
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ══════════════════ RIGHT: template selection + preview ══════════════════ -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E0D5C4" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="BARCODE TEMPLATE" FontWeight="Bold" FontSize="12"
                               Foreground="#495057" Margin="0,0,0,6"/>

                    <ListBox Grid.Row="1" x:Name="TemplateList"
                             SelectionChanged="TemplateList_SelectionChanged"
                             Margin="0,0,0,8">
                        <ListBoxItem Content="Standard (Name + Barcode + MRP/Sale)" Tag="Standard"/>
                        <ListBoxItem Content="Compact (Barcode only)" Tag="Compact"/>
                        <ListBoxItem Content="Detailed (+ HSN, Size, Colour)" Tag="Detailed"/>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ New Template" Padding="8,4" Margin="0,0,6,0" Click="NewTemplateButton_Click"/>
                        <Button Content="Edit Selected" Padding="8,4" Click="EditTemplateButton_Click"/>
                    </StackPanel>

                    <Separator Grid.Row="3" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Text="PREVIEW" FontWeight="Bold" FontSize="12"
                               Foreground="#495057" Margin="0,0,0,8"/>

                    <Border Grid.Row="5" BorderBrush="#B0A090" BorderThickness="1" CornerRadius="6"
                            Background="#FAFAFA" Padding="10" VerticalAlignment="Top" MinHeight="180">
                        <Grid>
                            <!-- All three built-in templates live here, one visible at a
                                 time, each bound to the DataGrid's SelectedItem. -->

                            <StackPanel x:Name="StandardPreview" HorizontalAlignment="Center"
                                        DataContext="{Binding ElementName=LabelsGrid, Path=SelectedItem}">
                                <TextBlock Text="My Store" FontSize="11" FontWeight="Bold"
                                           Foreground="#1F3A5F" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,2,0,4"/>
                                <Image Source="{Binding BarcodeImage}" Width="200" Height="55" Stretch="Fill"/>
                                <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="MRP: ₹" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MRP, StringFormat=N2}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Text="Sale: ₹" FontSize="10"/>
                                    <TextBlock Text="{Binding Retail, StringFormat=N2}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="CompactPreview" HorizontalAlignment="Center" Visibility="Collapsed"
                                        DataContext="{Binding ElementName=LabelsGrid, Path=SelectedItem}">
                                <Image Source="{Binding BarcodeImage}" Width="200" Height="60" Stretch="Fill"/>
                                <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontWeight="SemiBold"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="DetailedPreview" HorizontalAlignment="Center" Visibility="Collapsed"
                                        DataContext="{Binding ElementName=LabelsGrid, Path=SelectedItem}">
                                <TextBlock Text="My Store" FontSize="11" FontWeight="Bold"
                                           Foreground="#1F3A5F" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,2,0,4"/>
                                <Image Source="{Binding BarcodeImage}" Width="200" Height="50" Stretch="Fill"/>
                                <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="MRP: ₹" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MRP, StringFormat=N2}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Text="Sale: ₹" FontSize="10"/>
                                    <TextBlock Text="{Binding Retail, StringFormat=N2}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="HSN: " FontSize="9" Foreground="#868E96"/>
                                    <TextBlock Text="{Binding HSNCode}" FontSize="9" Foreground="#868E96" Margin="0,0,8,0"/>
                                    <TextBlock Text="Size: " FontSize="9" Foreground="#868E96"/>
                                    <TextBlock Text="{Binding Size}" FontSize="9" Foreground="#868E96" Margin="0,0,8,0"/>
                                    <TextBlock Text="Colour: " FontSize="9" Foreground="#868E96"/>
                                    <TextBlock Text="{Binding Colour}" FontSize="9" Foreground="#868E96"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Custom (user-designed) templates render here at runtime
                                 via TemplateRenderer.Render — see UpdatePreviewVisibility()
                                 in the code-behind. Scaled down if larger than the box. -->
                            <Viewbox x:Name="CustomTemplateViewbox" Stretch="Uniform" StretchDirection="DownOnly"
                                     MaxWidth="260" MaxHeight="220" Visibility="Collapsed">
                                <ContentControl x:Name="CustomTemplatePreview"/>
                            </Viewbox>

                            <TextBlock Text="Select a row on the left to preview its label"
                                       x:Name="NoSelectionHint"
                                       Foreground="#ADB5BD" FontStyle="Italic" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Width="200"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="🖨 Print Selected"
                    Click="PrintSelectedButton_Click"
                    Width="140" Height="36" Margin="0,0,8,0"
                    Background="#FF1F3A5F"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="Close" Click="CloseButton_Click" Width="90" Height="36" Background="#EEEEEE"/>
        </StackPanel>
    </Grid>
</Window>
