<Window x:Class="MyWPFCRUDApp.Views.BarcodeLabelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Barcode Labels"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        
        Background="#FFFDF8F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Barcode Labels for this Invoice"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  x:Name="LabelsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F4EE"
                  BorderBrush="#E0D5C4" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Print?" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <!-- Column 1: Barcode -->
                <!-- Column 1: Barcode — click to reveal/hide the label -->
                <DataGridTemplateColumn Header="Barcode" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Barcode}"
                       FontFamily="Consolas" FontWeight="SemiBold"
                       Foreground="#1971C2"
                       VerticalAlignment="Center"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       MouseLeftButtonUp="BarcodeText_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Column 2: Quantity -->
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Column 3: Label (rendered inline, no popup) -->
                <!-- Column 3: Label — hidden until IsLabelVisible is toggled on -->
                <DataGridTemplateColumn Header="Label" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#B0A090" BorderThickness="1" CornerRadius="6"
                    Background="White" Padding="10" Margin="4"
                    Visibility="{Binding IsLabelVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="My Store" FontSize="11" FontWeight="Bold"
                               Foreground="#1F3A5F" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProductName}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,4"/>
                                    <Image Source="{Binding BarcodeImage}" Width="180" Height="50" Stretch="Fill"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="MRP: ₹" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MRP, StringFormat=N2}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="Sale: ₹" FontSize="10"/>
                                        <TextBlock Text="{Binding Retail, StringFormat=N2}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="CloseButton_Click" Width="90" Height="36" Background="#EEEEEE"/>
        </StackPanel>
    </Grid>
</Window>