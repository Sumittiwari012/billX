<Window x:Class="MyWPFCRUDApp.Views.ApiKeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Bill Scan — API Key Setup"
        Width="520" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🤖" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Groq AI — API Key Required"
                           FontSize="16" FontWeight="Bold" Foreground="#1F3A5F"/>
                <TextBlock Text="One-time setup. Key is saved securely on this machine."
                           FontSize="11" Foreground="#6C757D"/>
            </StackPanel>
        </StackPanel>

        <!-- Instructions -->
        <Border Grid.Row="1"
                Background="#E7F5FF" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="11" Foreground="#1971C2" TextWrapping="Wrap">
                    <Run FontWeight="Bold">How to get your free key:</Run>
                    <Run> Go to </Run>
                    <Run FontWeight="Bold">console.groq.com</Run>
                    <Run> → Sign in → API Keys → Create API Key</Run>
                </TextBlock>
                <TextBlock Text="The key starts with  gsk_..."
                           FontSize="11" Foreground="#1971C2" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Key input -->
        <TextBlock Grid.Row="2"
                   Text="Paste your Groq API Key:"
                   FontSize="12" FontWeight="Bold"
                   Margin="0,0,0,6"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="PbKey"
                         Grid.Column="0"
                         Height="34"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         BorderBrush="#ADB5BD"
                         PasswordChanged="PbKey_PasswordChanged"/>

            <CheckBox x:Name="ChkShow"
                      Grid.Column="1"
                      Content="Show"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Checked="ChkShow_Checked"
                      Unchecked="ChkShow_Unchecked"/>
        </Grid>

        <!-- Visible text box (toggled by Show checkbox) -->
        <TextBox x:Name="TbKeyVisible"
                 Grid.Row="3"
                 Height="34" FontSize="13"
                 VerticalContentAlignment="Center"
                 Padding="8,0"
                 BorderBrush="#ADB5BD"
                 Visibility="Collapsed"
                 FontFamily="Consolas"
                 TextChanged="TbKeyVisible_TextChanged"
                 Margin="0,0,46,0"/>

        <!-- Status message -->
        <TextBlock x:Name="TbStatus"
                   Grid.Row="4"
                   FontSize="11"
                   Margin="0,8,0,0"
                   Foreground="#E03131"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Clear existing key -->
            <Button x:Name="BtnClear"
                    Grid.Column="0"
                    Content="Clear Saved Key"
                    HorizontalAlignment="Left"
                    Width="120" Height="34"
                    Background="White"
                    BorderBrush="#DEE2E6"
                    Foreground="#6C757D"
                    Click="BtnClear_Click"
                    Visibility="Collapsed"/>

            <Button Content="Cancel"
                    Grid.Column="1"
                    Width="90" Height="34"
                    Margin="0,0,10,0"
                    Background="White"
                    BorderBrush="#DEE2E6"
                    Click="BtnCancel_Click"/>

            <Button x:Name="BtnSave"
                    Content="Save &amp; Continue"
                    Grid.Column="2"
                    Width="140" Height="34"
                    Background="#1F3A5F"
                    Foreground="White"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
